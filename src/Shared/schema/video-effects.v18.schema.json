  "$defs": {
    "GlitchLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Enabled",
        "Mode",
        "Strength",
        "Rate",
        "Coverage",
        "Size",
        "RgbOffset"
      ],
      "properties": {
        "Enabled": {
          "type": "boolean"
        },
        "Mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "0 horizontal tearing; 1 displaced blocks; 2 thin jitter strips; 3 RGB ghosting"
        },
        "Strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "Rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "description": "pattern changes per second"
        },
        "Coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "Size": {
          "type": "number",
          "minimum": 2,
          "maximum": 240,
          "description": "pixels at 1080 output height"
        },
        "RgbOffset": {
          "type": "number",
          "minimum": 0,
          "maximum": 80,
          "description": "pixels at 1080 output height"
        }
      }
    }
  },
