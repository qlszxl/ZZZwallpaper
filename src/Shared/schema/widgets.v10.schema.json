{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZZZwallpaper widgets v10",
  "description": "Spectrum shapes, center emphasis and up to eight overlay layers; all existing widgets and positions are preserved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Version",
    "Widgets",
    "Groups",
    "Shortcuts",
    "LayoutGroups"
  ],
  "properties": {
    "Version": {
      "const": 10
    },
    "Widgets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "Id",
          "Kind",
          "Enabled",
          "Screen",
          "X",
          "Y",
          "Width",
          "Height",
          "Opacity",
          "Group"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "Kind": {
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5,
              6
            ]
          },
          "Enabled": {
            "type": "boolean"
          },
          "Screen": {
            "type": "string",
            "maxLength": 128
          },
          "X": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "Y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "Width": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 1
          },
          "Height": {
            "type": "number",
            "minimum": 0.03,
            "maximum": 1
          },
          "Opacity": {
            "type": "number",
            "minimum": 0.35,
            "maximum": 1
          },
          "Group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "ShortcutId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64
          },
          "IconOnly": {
            "type": "boolean",
            "default": false
          },
          "RefreshSeconds": {
            "enum": [
              1,
              2,
              5
            ],
            "default": 1
          },
          "Icon": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 65536,
            "description": "Local PNG, max 128x128, base64 encoded."
          },
          "LayoutGroupId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64
          },
          "LayoutOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "Locked": {
            "type": "boolean",
            "default": false
          },
          "Metrics": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255,
            "default": 3,
            "description": "Flags: CPU 1, memory 2, GPU 4, dedicated GPU memory 8, disk read 16, disk write 32, network receive 64, network send 128."
          },
          "Spectrum": {
            "type": "object",
            "properties": {
              "Width": {
                "type": "integer",
                "minimum": 24,
                "maximum": 16384
              },
              "Height": {
                "type": "integer",
                "minimum": 24,
                "maximum": 16384
              },
              "Bands": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256
              },
              "Sensitivity": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 4,
                "default": 1.5
              },
              "SmoothingMs": {
                "type": "integer",
                "minimum": 50,
                "maximum": 800,
                "default": 180
              },
              "Mirror": {
                "type": "boolean",
                "default": false
              },
              "Background": {
                "type": "boolean",
                "default": true
              },
              "Color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "ColorEnd": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "Gradient": {
                "type": "boolean"
              },
              "Gap": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.9
              },
              "Radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 40
              },
              "MinimumHeight": {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              "Padding": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "Direction": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "Reverse": {
                "type": "boolean"
              },
              "Peaks": {
                "type": "boolean"
              },
              "Shape": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "CenterEmphasis": {
                "type": "boolean"
              },
              "Enabled": {
                "type": "boolean"
              },
              "StrokeWidth": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 20
              },
              "RingRadius": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 0.85
              },
              "Opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "Scale": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 2
              },
              "OffsetX": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "OffsetY": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "Rotation": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "SubSpectra": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "properties": {
                    "Width": {
                      "type": "integer",
                      "minimum": 24,
                      "maximum": 16384
                    },
                    "Height": {
                      "type": "integer",
                      "minimum": 24,
                      "maximum": 16384
                    },
                    "Bands": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 256
                    },
                    "Sensitivity": {
                      "type": "number",
                      "minimum": 0.25,
                      "maximum": 4,
                      "default": 1.5
                    },
                    "SmoothingMs": {
                      "type": "integer",
                      "minimum": 50,
                      "maximum": 800,
                      "default": 180
                    },
                    "Mirror": {
                      "type": "boolean",
                      "default": false
                    },
                    "Background": {
                      "type": "boolean",
                      "default": true
                    },
                    "Color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "ColorEnd": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "Gradient": {
                      "type": "boolean"
                    },
                    "Gap": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 0.9
                    },
                    "Radius": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 40
                    },
                    "MinimumHeight": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "Padding": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "Direction": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "Reverse": {
                      "type": "boolean"
                    },
                    "Peaks": {
                      "type": "boolean"
                    },
                    "Shape": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "CenterEmphasis": {
                      "type": "boolean"
                    },
                    "Enabled": {
                      "type": "boolean"
                    },
                    "StrokeWidth": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 20
                    },
                    "RingRadius": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 0.85
                    },
                    "Opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "Scale": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 2
                    },
                    "OffsetX": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "OffsetY": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "Rotation": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    },
                    "SubSpectra": {
                      "type": "array",
                      "maxItems": 0
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "Visual": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Width": {
                "type": "integer",
                "minimum": 24,
                "maximum": 16384
              },
              "Height": {
                "type": "integer",
                "minimum": 24,
                "maximum": 16384
              },
              "Text": {
                "type": "string",
                "maxLength": 2000
              },
              "FontSize": {
                "type": "number",
                "minimum": 8,
                "maximum": 240
              },
              "Bold": {
                "type": "boolean"
              },
              "Alignment": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "TextColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "FillColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "Background": {
                "type": "boolean"
              },
              "FillOpacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "Radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 300
              },
              "Padding": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "BorderWidth": {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              "BorderColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "Image": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2800000
              },
              "StickerShape": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "ImageFit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "FlipHorizontal": {
                "type": "boolean"
              },
              "MaskShape": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "Gradient": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "ClickThrough": {
                "type": "boolean"
              }
            }
          },
          "Layer": {
            "type": "integer",
            "minimum": -999,
            "maximum": 999,
            "default": 0,
            "description": "Higher layers cover lower layers; equal layers follow component list order, first in front."
          },
          "Search": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Width": {
                "type": "integer",
                "minimum": 120,
                "maximum": 16384,
                "default": 360
              },
              "Height": {
                "type": "integer",
                "minimum": 44,
                "maximum": 16384,
                "default": 44
              },
              "Radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192,
                "default": 22
              }
            }
          }
        }
      }
    },
    "Groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "Id",
          "Name",
          "Order"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "Name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "Order": {
            "type": "integer"
          }
        }
      }
    },
    "Shortcuts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "Id",
          "Name",
          "Url",
          "Group",
          "Order",
          "Icon"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "Name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "Url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Legacy field name: website URL, absolute folder path, or a single-line cmd.exe command, according to Kind."
          },
          "Group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "Order": {
            "type": "integer"
          },
          "Icon": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 65536
          },
          "Kind": {
            "enum": [
              0,
              1,
              2
            ],
            "default": 0,
            "description": "0 website, 1 folder, 2 command"
          },
          "WorkingDirectory": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "ShowCommandWindow": {
            "type": "boolean",
            "default": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "Kind": {
                  "const": 0
                }
              }
            },
            "then": {
              "properties": {
                "Url": {
                  "format": "uri",
                  "pattern": "^https?://"
                }
              }
            }
          }
        ]
      }
    },
    "LayoutGroups": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "Id",
          "Name",
          "Screen",
          "X",
          "Y",
          "Flow",
          "HorizontalAlignment",
          "VerticalAlignment",
          "Gap",
          "Columns"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "Name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "Screen": {
            "type": "string",
            "maxLength": 128
          },
          "X": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "Y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "Flow": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "HorizontalAlignment": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "VerticalAlignment": {
            "enum": [
              0,
              1,
              2
            ]
          },
          "Gap": {
            "type": "number",
            "minimum": 0,
            "maximum": 80
          },
          "Columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "Locked": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "$id": "widgets.v9.schema.json"
}
