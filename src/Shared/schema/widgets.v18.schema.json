                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 20
                    },
                    "RingRadius": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 0.85
                    },
                    "Opacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "Scale": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 2
                    },
