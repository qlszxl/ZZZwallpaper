<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LumaWall.ControlCenter" x:Class="LumaWall.ControlCenter.LibraryPage" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
      <Grid x:Name="Surface" x:FieldModifier="internal" RowSpacing="14">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <ContentControl Style="{StaticResource HomeFrame}" Padding="14,12">
        <StackPanel Spacing="8">
          <ScrollViewer x:Name="LibraryToolbarScroll" x:FieldModifier="internal" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False">
          <Grid x:Name="LibraryFilterGrid" x:FieldModifier="internal" ColumnSpacing="14" RowSpacing="10">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="LibraryFolderPicker" x:FieldModifier="internal" Style="{StaticResource HomeComboBox}" Height="48" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:UiString Source='查看文件夹范围'}">
           <ComboBox.ItemTemplate>
            <DataTemplate>
             <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource BodyFont}" />
            </DataTemplate>
           </ComboBox.ItemTemplate>
          </ComboBox>
          <Grid x:Name="LibraryFilterActions" x:FieldModifier="internal" Grid.Column="1" ColumnSpacing="10" RowSpacing="8" HorizontalAlignment="Stretch">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
           </Grid.ColumnDefinitions>
           <CheckBox x:Name="IncludeSubfoldersCheck" x:FieldModifier="internal" Content="{local:UiString Source='包含子文件夹'}" IsChecked="True" Style="{StaticResource LibraryCheckBox}" VerticalAlignment="Center" />
           <Button x:Name="RefreshFolderButton" x:FieldModifier="internal" Grid.Column="1" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='刷新文件夹'}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
             <Viewbox Width="22" Height="22" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center">
              <Path Width="24" Height="24" Stretch="None" Data="F0 M12,2 C15.2,2 18,3.5 19.8,5.8 L23,3 L23,12 L14,12 L17.2,9.1 C16.1,7.2 14.2,6 12,6 C8.7,6 6,8.7 6,12 C6,15.3 8.7,18 12,18 C14.6,18 16.8,16.3 17.7,14 L21.9,14 C21,18.6 16.9,22 12,22 C6.5,22 2,17.5 2,12 C2,6.5 6.5,2 12,2 Z" Fill="{Binding Foreground, ElementName=RefreshFolderButton}" />
             </Viewbox>
             <TextBlock Text="{local:UiString Source='刷新文件夹'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
            </StackPanel>
           </Button>
           <Button x:Name="RemoveFolderButton" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='移除来源'}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
             <Viewbox Width="22" Height="22" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center">
              <Path Width="24" Height="24" Stretch="None" Data="F0 M3,4 L9,4 L12,7 L20,7 Q22,7 22,9 L22,12 L18,12 L18,11 L5,11 L5,18 L11,18 L11,22 L3,22 Q1,22 1,20 L1,6 Q1,4 3,4 Z M13,16 L23,16 L23,20 L13,20 Z" Fill="{Binding Foreground, ElementName=RemoveFolderButton}" />
             </Viewbox>
             <TextBlock Text="{local:UiString Source='移除来源'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
            </StackPanel>
           </Button>
          </Grid>
         </Grid>
          </ScrollViewer>
           <TextBlock x:Name="FolderStatus" x:FieldModifier="internal" FontSize="11" Foreground="#999999" TextWrapping="Wrap" FontFamily="{StaticResource BodyFont}" />
         <StackPanel x:Name="LibrarySearchControls" x:FieldModifier="internal" Spacing="10" />
        </StackPanel>
       </ContentControl>
       <Grid Grid.Row="1" x:Name="LibraryWorkspace" x:FieldModifier="internal" ColumnSpacing="14" RowSpacing="14" Background="Transparent">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition x:Name="LibraryInfoColumn" x:FieldModifier="internal" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2">
         <local:LibraryGridView x:Name="LibraryList" x:FieldModifier="internal" AllowDrop="True" Background="Transparent" ItemTemplate="{StaticResource LibraryAssetCard}" Style="{StaticResource LibraryGridView}" ItemContainerStyle="{StaticResource LibraryGridViewItem}" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False" IsItemClickEnabled="False" Padding="0,0,4,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <GridView.ItemsPanel>
           <ItemsPanelTemplate>
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
           </ItemsPanelTemplate>
          </GridView.ItemsPanel>

         </local:LibraryGridView>
         <ContentControl x:Name="LibraryEmptyState" x:FieldModifier="internal" Style="{StaticResource HomeFrame}" Padding="24" Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center" Spacing="16">
           <Viewbox Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <Path Width="24" Height="24" Stretch="None" Data="F0 M3,3 L17,3 Q19,3 19,5 L19,8 L24,5 L24,19 L19,16 L19,19 Q19,21 17,21 L3,21 Q1,21 1,19 L1,5 Q1,3 3,3 Z M5,7 L5,17 L15,17 L15,7 Z" Fill="{StaticResource InteractionAccentBrush}" />
           </Viewbox>
           <TextBlock x:Name="EmptyLibrary" x:FieldModifier="internal" Text="{local:UiString Source='暂无素材'}" TextWrapping="Wrap" TextAlignment="Center" FontFamily="{StaticResource BodyFont}" />
           <Button x:Name="LibraryEmptyImportButton" x:FieldModifier="internal" Style="{StaticResource HomePrimaryButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{local:UiString Source='添加素材'}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
             <Viewbox Width="22" Height="22" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center">
              <Path Width="24" Height="24" Stretch="None" Data="F0 M3,3 L16,3 Q18,3 18,5 L18,7 L23,4 L23,13 L19,13 L19,11 L15,11 L15,15 L11,15 L11,20 L3,20 Q1,20 1,18 L1,5 Q1,3 3,3 Z M4,6 L4,17 L8,17 L8,12 L12,12 L12,8 L15,8 L15,6 Z M16,13 L19,13 L19,16 L22,16 L22,19 L19,19 L19,22 L16,22 L16,19 L13,19 L13,16 L16,16 Z" Fill="{Binding Foreground, ElementName=LibraryEmptyImportButton}" />
             </Viewbox>
             <TextBlock Text="{local:UiString Source='添加素材'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
            </StackPanel>
           </Button>
          </StackPanel>
         </ContentControl>
        </Grid>
        <ContentControl Grid.Column="1" x:Name="LibraryInformationPanel" x:FieldModifier="internal" Visibility="Collapsed" Style="{StaticResource HomeFrame}" Padding="14">
         <ScrollViewer Style="{StaticResource HomeScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12">
           <TextBlock Text="{local:UiString Source='素材信息'}" Style="{StaticResource SectionTitle}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" />
           <Border x:Name="LibraryInfoPosterFrame" x:FieldModifier="internal" Style="{StaticResource LibraryInset}" CornerRadius="12" Height="136" Padding="3">
            <Grid Background="#1A1D1E" CornerRadius="8">
             <Viewbox Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
              <Path Width="24" Height="24" Stretch="None" Data="F0 M3,3 L17,3 Q19,3 19,5 L19,8 L24,5 L24,19 L19,16 L19,19 Q19,21 17,21 L3,21 Q1,21 1,19 L1,5 Q1,3 3,3 Z M5,7 L5,17 L15,17 L15,7 Z" Fill="#F3F4EE" />
             </Viewbox>
             <Image x:Name="LibraryInfoPoster" x:FieldModifier="internal" Stretch="UniformToFill" />
            </Grid>
           </Border>
           <TextBlock x:Name="LibraryInfoTitle" x:FieldModifier="internal" Text="{local:UiString Source='未选择素材'}" FontSize="20" FontWeight="Black" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource DisplayFont}" />
           <TextBlock x:Name="LibraryInfoMetadata" x:FieldModifier="internal" Text="" Foreground="#BBBBBB" FontSize="13" TextWrapping="Wrap" FontFamily="{StaticResource BodyFont}" />
           <Border Style="{StaticResource LibraryInset}" Padding="10" CornerRadius="12">
            <TextBlock x:Name="LibraryInfoPath" x:FieldModifier="internal" Text="—" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" FontFamily="{StaticResource BodyFont}" />
           </Border>
           <StackPanel x:Name="LibrarySelectionActions" x:FieldModifier="internal" Spacing="9">
            <Button x:Name="LibraryRevealSourceButton" x:FieldModifier="internal" Content="{local:UiString Source='在资源管理器中打开'}" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:UiString Source='在资源管理器中打开'}" AutomationProperties.AutomationId="LibraryRevealSource" />
            <Button x:Name="LibraryApplyButton" x:FieldModifier="internal" Style="{StaticResource HomePrimaryButton}" Background="{StaticResource InteractionAccentBrush}" Foreground="{StaticResource HomeControlInk}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='应用所选素材'}">
             <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Viewbox Width="22" Height="22" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center">
               <Path Width="24" Height="24" Stretch="None" Data="F0 M4,2 L20,2 Q23,2 23,5 L23,16 Q23,19 20,19 L14,19 L14,21 L18,21 L18,24 L6,24 L6,21 L10,21 L10,19 L4,19 Q1,19 1,16 L1,5 Q1,2 4,2 Z M4,5 L4,16 L20,16 L20,5 Z" Fill="{Binding Foreground, ElementName=LibraryApplyButton}" />
              </Viewbox>
              <TextBlock Text="{local:UiString Source='应用所选素材'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
             </StackPanel>
            </Button>
            <Button x:Name="LibraryQueueButton" x:FieldModifier="internal" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='加入播放队列'}">
             <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Viewbox Width="22" Height="22" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center">
               <Path Width="24" Height="24" Stretch="None" Data="F0 M2,3 L6,3 L6,7 L2,7 Z M9,3 L22,3 L22,7 L9,7 Z M2,10 L6,10 L6,14 L2,14 Z M9,10 L22,10 L22,14 L9,14 Z M2,17 L6,17 L6,21 L2,21 Z M9,17 L14,17 L14,21 L9,21 Z M18,16 L24,20 L18,24 Z" Fill="{Binding Foreground, ElementName=LibraryQueueButton}" />
              </Viewbox>
              <TextBlock Text="{local:UiString Source='加入播放队列'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
             </StackPanel>
            </Button>
            <Button x:Name="LibraryPosterButton" x:FieldModifier="internal" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='选择视频封面帧'}">
             <TextBlock Text="{local:UiString Source='选择封面帧'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" TextLineBounds="Full" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="LibraryDecodeTestButton" x:FieldModifier="internal" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='测试此视频的解码性能'}">
             <TextBlock Text="{local:UiString Source='解码性能测试'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" TextLineBounds="Full" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="LibraryRelinkButton" x:FieldModifier="internal" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='重新关联源文件'}">
             <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Viewbox Width="22" Height="22" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center">
               <Path Width="24" Height="24" Stretch="None" Data="F0 M10.3,4.3 L12.5,2.1 C15.1,-0.5 19.4,-0.5 22,2.1 C24.6,4.7 24.6,9 22,11.6 L18.6,15 C16,17.6 11.7,17.6 9.1,15 L12,12.1 C13,13.1 14.7,13.1 15.7,12.1 L19.1,8.7 C20.1,7.7 20.1,6 19.1,5 C18.1,4 16.4,4 15.4,5 L13.2,7.2 Z M13.7,19.7 L11.5,21.9 C8.9,24.5 4.6,24.5 2,21.9 C-0.6,19.3 -0.6,15 2,12.4 L5.4,9 C8,6.4 12.3,6.4 14.9,9 L12,11.9 C11,10.9 9.3,10.9 8.3,11.9 L4.9,15.3 C3.9,16.3 3.9,18 4.9,19 C5.9,20 7.6,20 8.6,19 L10.8,16.8 Z" Fill="{Binding Foreground, ElementName=LibraryRelinkButton}" />
              </Viewbox>
              <TextBlock Text="{local:UiString Source='重新关联源文件'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
             </StackPanel>
            </Button>
            <Button x:Name="LibraryRemoveButton" x:FieldModifier="internal" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='移除引用'}">
             <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Viewbox Width="22" Height="22" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center">
               <Path Width="24" Height="24" Stretch="None" Data="F0 M8,1 L16,1 L17,4 L22,4 L22,8 L2,8 L2,4 L7,4 Z M4,10 L20,10 L19,22 Q19,24 17,24 L7,24 Q5,24 5,22 Z M8,12 L8.7,21 L11,21 L11,12 Z M13,12 L13,21 L15.3,21 L16,12 Z" Fill="{Binding Foreground, ElementName=LibraryRemoveButton}" />
              </Viewbox>
              <TextBlock Text="{local:UiString Source='移除引用'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
             </StackPanel>
            </Button>
            <Button x:Name="LibraryDeleteSourceButton" x:FieldModifier="internal" Content="{local:UiString Source='删除源文件'}" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:UiString Source='删除源文件'}" AutomationProperties.AutomationId="LibraryDeleteSource" />
           </StackPanel>
          </StackPanel>
         </ScrollViewer>
        </ContentControl>
       </Grid>
      </Grid>
</UserControl>
