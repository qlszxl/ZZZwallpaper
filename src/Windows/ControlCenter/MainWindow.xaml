<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LumaWall.ControlCenter" x:Class="LumaWall.ControlCenter.MainWindow" Title="ZZZwallpaper">
 <Grid x:Name="ShellViewport" Background="Transparent">
 <Viewbox x:Name="ShellScaleHost" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent" Loaded="Root_Loaded" KeyDown="EffectsPage_KeyDown" SizeChanged="EffectsPage_SizeChanged">
  <Grid.RowDefinitions>
   <RowDefinition x:Name="ShellHeaderRow" Height="112" />
   <RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <Grid x:Name="ShellBackground" Grid.RowSpan="2" Background="#070707" Margin="0,32,0,0" IsHitTestVisible="False">
  <Image Source="ms-appx:///Assets/Effects/shell.svg" Stretch="UniformToFill" IsHitTestVisible="False" x:Name="ShellStaticBackground" />
  <Grid x:Name="HomeAnimatedBackground" Background="#0C0E0F" Visibility="Collapsed" IsHitTestVisible="False">
   <Grid.Clip>
    <RectangleGeometry x:Name="HomeBackgroundClip" />
   </Grid.Clip>
   <Grid x:Name="HomeBrandBackdropHost" IsHitTestVisible="False" />
  </Grid>
  </Grid>
  <Grid>
   <Border BorderBrush="#3B3B3B" BorderThickness="1,1,1,3" CornerRadius="22,22,0,0" Background="#B8070707" Margin="0,32,0,0" x:Name="ShellHeaderBorder" IsHitTestVisible="False" />
   <Grid Padding="20,0,16,0" ColumnSpacing="18">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="Auto" />
     <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid x:Name="ShellTitleDragRegion" Background="Transparent">
     <!-- A single-window visual: DWM animates this with the rest of the shell. -->
     <Viewbox x:Name="ShellWordmarkVisual" MaxWidth="670" MaxHeight="109" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,2" IsHitTestVisible="False" AutomationProperties.Name="ZZZwallpaper">
      <Image Source="ms-appx:///Assets/Branding/wordmark.png" Width="2071" Height="336" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
     </Viewbox>
    </Grid>
    <Border Grid.Column="1" Style="{StaticResource EffectsValueCapsule}" Padding="12,0,4,0" CornerRadius="24" Margin="0,32,0,0" x:Name="ShellScreenCapsule">
     <Border x:Name="ShellScreenInset">
      <StackPanel Orientation="Horizontal" Spacing="10">
       <FontIcon Glyph="" FontSize="21" Foreground="#19D9E9" x:Name="ShellScreenIcon"  VerticalAlignment="Center"/>
       <ComboBox x:Name="ScreenPicker" MinWidth="0" MaxWidth="310" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" SelectionChanged="Screen_Changed" AutomationProperties.Name="{local:UiString Source='当前编辑屏幕'}"  VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
    </Border>
    <StackPanel x:Name="ShellCaptionButtons" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,32,0,0" Visibility="Collapsed">
     <local:WindowCaptionButton x:Name="ShellMinimizeButton" GlyphKind="Minimize" Style="{StaticResource ShellCaptionButton}" Click="ShellMinimize_Click" AutomationProperties.Name="{local:UiString Source='最小化'}" />
     <local:WindowCaptionButton x:Name="ShellMaximizeButton" GlyphKind="Maximize" Style="{StaticResource ShellCaptionButton}" Click="ShellMaximize_Click" AutomationProperties.Name="{local:UiString Source='最大化'}" />
     <local:WindowCaptionButton x:Name="ShellCloseButton" GlyphKind="Close" Style="{StaticResource ShellCaptionButton}" Click="ShellClose_Click" AutomationProperties.Name="{local:UiString Source='关闭窗口'}" />
    </StackPanel>
   </Grid>
  </Grid>
  <ContentControl x:Name="EffectsBodyHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False">
   <Grid x:Name="EffectsBody" Margin="24,16,24,22" ColumnSpacing="18">
    <Grid.ColumnDefinitions>
     <ColumnDefinition x:Name="EffectsNavigationColumn" Width="224" />
     <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid x:Name="CassetteNavigationHost">
     <Border x:Name="ShellNavigationBorder" CornerRadius="18" BorderBrush="#414141" BorderThickness="1" Padding="3" Background="{StaticResource HomeRimBrush}">
      <Border CornerRadius="15" BorderBrush="#020202" BorderThickness="2" Background="{StaticResource CassetteCaseBrush}">
       <Border x:Name="ShellNavigationInset" CornerRadius="13" BorderBrush="#333333" BorderThickness="1">
        <Grid>
         <local:CassetteGrain Opacity="0.48" Margin="2"/>
         <Grid Padding="8,28,8,28" RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Button x:Name="CassetteLabelButton" Height="64" Style="{StaticResource HomeSegmentButton}" Click="CassetteLabel_Click" AutomationProperties.Name="{local:UiString Source='展开完整导航'}" IsTabStop="False" IsHitTestVisible="False">
           <Grid>
            <local:CassetteSlice x:Name="CassetteBrandLabel" Part="Label"/>
            <Border x:Name="CassetteSpineLabel" Background="#DAD6C9" CornerRadius="4" Visibility="Collapsed">
             <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="#151515"/>
              <TextBlock Text="VHS" FontSize="11" FontWeight="Black" Foreground="#151515" IsTextScaleFactorEnabled="False"/>
             </StackPanel>
            </Border>
           </Grid>
          </Button>
          <local:CassetteClipPanel x:Name="CassetteNavigationBody" Grid.Row="1">
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" x:Name="ShellNavigationScroll">
            <StackPanel x:Name="EffectsGlobalNavigation" Spacing="8">
          <local:CassetteNavButton Number="01" Tag="wallpaper" Click="Nav_Click" Style="{StaticResource CassetteNavButtonStyle}" AutomationProperties.Name="{local:UiString Source='首页'}" x:Name="WallpaperNav">
           <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE80F;" FontSize="24" VerticalAlignment="Center"/>
            <TextBlock Text="{local:UiString Source='首页'}" FontSize="20" FontWeight="Black" FontStyle="Italic" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
           </StackPanel>
          </local:CassetteNavButton>
          <local:CassetteNavButton Number="02" Tag="library" Click="Nav_Click" Style="{StaticResource CassetteNavButtonStyle}" AutomationProperties.Name="{local:UiString Source='素材库'}" x:Name="LibraryNav">
           <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE714;" FontSize="24" VerticalAlignment="Center"/>
            <TextBlock Text="{local:UiString Source='素材库'}" FontSize="20" FontWeight="Black" FontStyle="Italic" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
           </StackPanel>
          </local:CassetteNavButton>
          <local:CassetteNavButton Number="03" Tag="display" Click="Nav_Click" Style="{StaticResource CassetteNavButtonStyle}" AutomationProperties.Name="{local:UiString Source='画面效果'}" x:Name="DisplayNav">
           <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE91B;" FontSize="24" VerticalAlignment="Center"/>
            <TextBlock Text="{local:UiString Source='画面效果'}" FontSize="20" FontWeight="Black" FontStyle="Italic" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
           </StackPanel>
          </local:CassetteNavButton>
          <local:CassetteNavButton Number="04" Tag="widgets" Click="Nav_Click" Style="{StaticResource CassetteNavButtonStyle}" AutomationProperties.Name="{local:UiString Source='组件'}" x:Name="WidgetsNav">
           <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xEA86;" FontSize="24" VerticalAlignment="Center"/>
            <TextBlock Text="{local:UiString Source='组件'}" FontSize="20" FontWeight="Black" FontStyle="Italic" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
           </StackPanel>
          </local:CassetteNavButton>
          <local:CassetteNavButton Number="05" Tag="presets" Click="Nav_Click" Style="{StaticResource CassetteNavButtonStyle}" AutomationProperties.Name="{local:UiString Source='预设'}" x:Name="PresetsNav">
           <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE8A5;" FontSize="24" VerticalAlignment="Center"/>
            <TextBlock Text="{local:UiString Source='预设'}" FontSize="20" FontWeight="Black" FontStyle="Italic" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
           </StackPanel>
          </local:CassetteNavButton>
          <local:CassetteNavButton Number="06" Tag="settings" Click="Nav_Click" Style="{StaticResource CassetteNavButtonStyle}" AutomationProperties.Name="{local:UiString Source='设置'}" x:Name="SettingsNav">
           <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE713;" FontSize="24" VerticalAlignment="Center"/>
            <TextBlock Text="{local:UiString Source='设置'}" FontSize="20" FontWeight="Black" FontStyle="Italic" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center"/>
           </StackPanel>
          </local:CassetteNavButton>
            </StackPanel>
           </ScrollViewer>
           <Grid x:Name="CassetteRelief" Grid.Row="1" Margin="0,12,0,0" IsHitTestVisible="False">
            <local:CassetteSlice Part="Relief" MaxHeight="250" VerticalAlignment="Bottom"/>
           </Grid>
          </local:CassetteClipPanel>
          <StackPanel Grid.Row="2" Spacing="8">
        <Border Background="{StaticResource HomeRimBrush}" CornerRadius="16" Padding="2" Margin="0">
         <Border Background="#020202" CornerRadius="14" Padding="1">
          <Border Background="#292929" CornerRadius="13" Padding="1">
           <Border Background="{StaticResource HomeWellBrush}" CornerRadius="12">
            <Grid x:Name="UndoSegments">
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
             <Grid.RowDefinitions><RowDefinition Height="44"/></Grid.RowDefinitions>
             <Button x:Name="UndoButton" Style="{StaticResource HomeSegmentButton}" CornerRadius="12,0,0,12" AutomationProperties.Name="{local:UiString Source='撤销'}">
              <Grid Width="24" Height="24" IsHitTestVisible="False">
               <Path Data="M9,3 L2,10 L9,17 L9,12 L14,12 C17.314,12 20,14.686 20,18 L20,21 L23,21 L23,18 C23,13.029 18.971,9 14,9 L9,9 Z" Fill="{Binding Foreground, ElementName=UndoButton}" Stretch="None"/>
              </Grid>
             </Button>
             <Border x:Name="UndoSegmentDivider" Grid.Column="1" Background="#343434" Margin="0,8" IsHitTestVisible="False"/>
             <Button x:Name="RedoButton" Grid.Column="2" Style="{StaticResource HomeSegmentButton}" CornerRadius="0,12,12,0" AutomationProperties.Name="{local:UiString Source='重做'}">
              <Grid Width="24" Height="24" IsHitTestVisible="False">
               <Path Data="M15,3 L22,10 L15,17 L15,12 L10,12 C6.686,12 4,14.686 4,18 L4,21 L1,21 L1,18 C1,13.029 5.029,9 10,9 L15,9 Z" Fill="{Binding Foreground, ElementName=RedoButton}" Stretch="None"/>
              </Grid>
             </Button>
            </Grid>
           </Border>
          </Border>
         </Border>
        </Border>

           <Border x:Name="CassetteServiceStatus" Height="36" CornerRadius="10" Background="#171717" BorderBrush="#343434" BorderThickness="1" Padding="8,0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
             <Ellipse x:Name="EffectsServiceDot" Width="10" Height="10" Fill="#888888" VerticalAlignment="Center"/>
             <TextBlock x:Name="EffectsServiceLabel" Text="{local:UiString Source='桌面服务准备中'}" FontSize="11" VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" IsTextSelectionEnabled="False"/>
            </StackPanel>
           </Border>
          </StackPanel>
         </Grid>
        </Grid>
       </Border>
      </Border>
     </Border>
     <local:CassetteScrew HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
     <local:CassetteScrew HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"/>
     <local:CassetteScrew HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5"/>
     <local:CassetteScrew HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
    </Grid>
    <Grid Grid.Column="1" RowSpacing="12">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
     </Grid.RowDefinitions>
     <Grid x:Name="PageHeader" MinHeight="54" ColumnSpacing="16" RowSpacing="12">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="PageHeadingText" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
       <TextBlock x:Name="PageTitle" Text="{local:UiString Source='我的桌面'}" FontSize="34" FontWeight="Black" FontStyle="Italic" FontFamily="{StaticResource DisplayFont}"  VerticalAlignment="Center"/>
       <TextBlock x:Name="PageSubtitle" Text="WALLPAPER" FontSize="13" FontWeight="Black" FontStyle="Italic" Foreground="#6D6D6D" VerticalAlignment="Bottom" Margin="0,0,0,8" FontFamily="{StaticResource DisplayFont}" />
      </StackPanel>
      <Grid x:Name="PageHeaderActions" Grid.Column="1" VerticalAlignment="Center">
       <StackPanel x:Name="HomeHeaderActions" Orientation="Horizontal" Spacing="10">
        <Button Padding="20,11" Style="{StaticResource HomeButton}" x:Name="HomeAddMediaButton" VerticalAlignment="Center">
         <Button.Flyout>
          <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource HomeMenuFlyoutPresenter}">
           <MenuFlyoutItem Text="{local:UiString Source='添加素材'}" Click="HomeImportVideo_Click" Style="{StaticResource HomeMenuFlyoutItem}" />
           <MenuFlyoutItem Text="{local:UiString Source='添加文件夹'}" Click="HomeImportFolder_Click" Style="{StaticResource HomeMenuFlyoutItem}" />
          </MenuFlyout>
         </Button.Flyout>
         <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Viewbox Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
               <Path Width="24" Height="24" Stretch="None" Data="F0 M3,4 L9,4 L12,7 L20,7 Q22,7 22,9 L22,12 L18,12 L18,11 L5,11 L5,18 L12,18 L12,22 L3,22 Q1,22 1,20 L1,6 Q1,4 3,4 Z M17,13 L20,13 L20,16 L23,16 L23,19 L20,19 L20,22 L17,22 L17,19 L14,19 L14,16 L17,16 Z" Fill="{Binding Foreground, ElementName=HomeAddMediaButton}" />
              </Viewbox>
          <TextBlock Text="{local:UiString Source='添加素材'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
          <Viewbox Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
           <Path Width="24" Height="24" Stretch="None" Data="M3,8 L6,5 L12,11 L18,5 L21,8 L12,17 Z" Fill="{Binding Foreground, ElementName=HomeAddMediaButton}" />
          </Viewbox>
         </StackPanel>
        </Button>
        <Button x:Name="QueueOpenButton" Click="QueueOpen_Click" Padding="20,11" Style="{StaticResource HomeButton}" VerticalAlignment="Center">
         <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Data="F0 M2,3 L6,3 L6,7 L2,7 Z M9,3 L22,3 L22,7 L9,7 Z M2,10 L6,10 L6,14 L2,14 Z M9,10 L22,10 L22,14 L9,14 Z M2,17 L6,17 L6,21 L2,21 Z M9,17 L22,17 L22,21 L9,21 Z" Width="22" Height="22"  VerticalAlignment="Center"/>
          <TextBlock x:Name="QueueButtonLabel" Text="{local:UiString Source='播放队列  0'}" FontWeight="Black" FontFamily="{StaticResource DisplayFont}"  VerticalAlignment="Center"/>
          <PathIcon Data="F0 M7.5,2 L18,12 L7.5,22 L4.5,18.8 L11.6,12 L4.5,5.2 Z" Width="22" Height="22"  VerticalAlignment="Center"/>
         </StackPanel>
        </Button>
       </StackPanel>
       <StackPanel x:Name="LibraryHeaderActions" Visibility="Collapsed" Orientation="Horizontal" Spacing="10">
        <Button x:Name="SteamImportButton" Click="SteamImport_Click" Content="{local:UiString Source='从 Wallpaper Engine 导入'}" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" VerticalAlignment="Center" AutomationProperties.Name="{local:UiString Source='从 Wallpaper Engine 导入'}" AutomationProperties.AutomationId="SteamImportEntry" />
        <Button x:Name="ImportButton" Click="Import_Click" Style="{StaticResource HomePrimaryButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='添加素材'}" VerticalAlignment="Center">
         <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Viewbox Width="22" Height="22" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center">
           <Path Width="24" Height="24" Stretch="None" Data="F0 M3,3 L16,3 Q18,3 18,5 L18,7 L23,4 L23,13 L19,13 L19,11 L15,11 L15,15 L11,15 L11,20 L3,20 Q1,20 1,18 L1,5 Q1,3 3,3 Z M4,6 L4,17 L8,17 L8,12 L12,12 L12,8 L15,8 L15,6 Z M16,13 L19,13 L19,16 L22,16 L22,19 L19,19 L19,22 L16,22 L16,19 L13,19 L13,16 L16,16 Z" Fill="{Binding Foreground, ElementName=ImportButton}" />
          </Viewbox>
          <TextBlock Text="{local:UiString Source='添加素材'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
         </StackPanel>
        </Button>
        <Button x:Name="ImportFolderButton" Click="ImportFolder_Click" Style="{StaticResource HomeButton}" Height="48" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" AutomationProperties.Name="{local:UiString Source='添加文件夹'}" VerticalAlignment="Center">
         <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Viewbox Width="22" Height="22" Stretch="Uniform" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Center">
           <Path Width="24" Height="24" Stretch="None" Data="F0 M3,4 L9,4 L12,7 L20,7 Q22,7 22,9 L22,12 L18,12 L18,11 L5,11 L5,18 L12,18 L12,22 L3,22 Q1,22 1,20 L1,6 Q1,4 3,4 Z M17,13 L20,13 L20,16 L23,16 L23,19 L20,19 L20,22 L17,22 L17,19 L14,19 L14,16 L17,16 Z" Fill="{Binding Foreground, ElementName=ImportFolderButton}" />
          </Viewbox>
          <TextBlock Text="{local:UiString Source='添加文件夹'}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" VerticalAlignment="Center" />
         </StackPanel>
        </Button>
       </StackPanel>
       <Grid x:Name="EffectsHeaderActions" ColumnSpacing="12" RowSpacing="10" HorizontalAlignment="Right" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="EffectsBackActions" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
         <Button x:Name="EffectsRemoveButton" Click="EffectsRemove_Click" Content="{local:UiString Source='移除效果'}" Style="{StaticResource UtilityButton}" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel x:Name="EffectsTargetActions" Orientation="Horizontal" Spacing="8">
        <StackPanel x:Name="EffectsTargetCaption" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
         <TextBlock x:Name="EffectsTargetKind" Text="{local:UiString Source='作用对象'}" FontSize="12" Foreground="{StaticResource HomeControlMuted}" FontFamily="{StaticResource BodyFont}" VerticalAlignment="Center"/>
         <ContentControl x:Name="EffectTargetHelpHost" IsTabStop="False" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="EffectsTargetButton" Click="EffectsTargetOpen_Click" Style="{StaticResource UtilityButton}" Width="320" MinWidth="0" Padding="12,0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{local:UiString Source='选择画面效果作用对象'}">
         <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <FontIcon x:Name="EffectsTargetIcon" Glyph="&#xE7F4;" FontSize="18" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
          <TextBlock x:Name="EffectsSelectedAsset" Grid.Column="1" Text="{local:UiString Source='显示器'}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontFamily="{StaticResource BodyFont}" VerticalAlignment="Center"/>
          <TextBlock x:Name="EffectsTargetResolution" Grid.Column="2" FontSize="12" FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource HomeControlMuted}" VerticalAlignment="Center"/>
          <Path Grid.Column="3" Width="10" Height="6" Stretch="Uniform" Data="M1,1 L5,5 L9,1" Stroke="{Binding Foreground, ElementName=EffectsTargetButton}" StrokeThickness="2" VerticalAlignment="Center" IsHitTestVisible="False"/>
         </Grid>
        </Button>
        </StackPanel>
       </Grid>
       <Grid x:Name="WidgetsHeaderActions" Visibility="Collapsed"/>

       <StackPanel x:Name="PerformanceHeaderActions" Visibility="Collapsed">
        <Button x:Name="PerformanceBaselineButton" Content="{local:UiString Source='记录当前数值作对照'}" Click="PerformanceBaseline_Click" IsEnabled="False" Style="{StaticResource UtilityButton}" Tag="utility-icon:Compare"/>
       </StackPanel>
      </Grid>
     </Grid>
     <InfoBar Grid.Row="1" x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational" />
     <Grid Grid.Row="2" x:Name="ShellPageContent">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="PagePinnedActions" Visibility="Collapsed" Margin="0,0,16,16">
       <local:MetalAddButton x:Name="EffectsAddButton" Visibility="Collapsed" Click="EffectsAdd_Click" Style="{StaticResource MetalAddButtonStyle}" Content="{local:UiString Source='添加效果'}" BackdropText="EFFECTS" AutomationProperties.Name="{local:UiString Source='添加效果'}"/>
       <local:MetalAddButton x:Name="WidgetsAddButton" Visibility="Collapsed" Click="WidgetsAdd_Click" Style="{StaticResource MetalAddButtonStyle}" Content="{local:UiString Source='添加组件'}" BackdropText="WIDGETS" AutomationProperties.Name="{local:UiString Source='添加组件'}"/>
      </Grid>
      <Grid Grid.Row="1" x:Name="ScrollablePages">
      <ScrollViewer x:Name="WallpaperScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" Style="{StaticResource HomeScrollViewer}">
       <Grid x:Name="WallpaperPanel" RowSpacing="14" VerticalAlignment="Top">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl Style="{StaticResource HomeFrame}" Padding="5" x:Name="HomePreviewCard" VerticalAlignment="Top">
         <Grid>
          <Grid.RowDefinitions>
           <RowDefinition Height="*" />
           <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border CornerRadius="12" Background="#111414">
           <Grid MinHeight="200" x:Name="HomePosterViewport">
            <Canvas x:Name="HomePreviewCanvas" IsHitTestVisible="False">
             <Image x:Name="PosterImage" Stretch="Fill"/>
             <Border x:Name="HomePreviewDimTop" Background="#AA000000"/>
             <Border x:Name="HomePreviewDimBottom" Background="#AA000000"/>
             <Border x:Name="HomePreviewDimLeft" Background="#AA000000"/>
             <Border x:Name="HomePreviewDimRight" Background="#AA000000"/>
             <Border x:Name="HomeMonitorFrame" BorderBrush="#99FFFFFF" BorderThickness="1"/>
            </Canvas>
            <StackPanel x:Name="EmptyPreview" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="24">
             <Viewbox Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
              <Path Data="F0 M5,3 L19,3 Q22,3 22,6 L22,19 Q22,22 19,22 L5,22 Q2,22 2,19 L2,6 Q2,3 5,3 Z M5,6 L5,19 L19,19 L19,6 Z M6,17 L10,12 L13,15 L15.5,12 L19,17 L19,19 L6,19 Z M17,9 Q17,11 15,11 Q13,11 13,9 Q13,7 15,7 Q17,7 17,9 Z" Stretch="Uniform" Fill="{StaticResource InteractionAccentBrush}" />
             </Viewbox>
             <TextBlock Text="{local:UiString Source='暂无壁纸'}" FontSize="25" FontWeight="Black" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" />
             <Button Content="{local:UiString Source='前往素材库'}" Tag="library" Click="Nav_Click" Style="{StaticResource HomePrimaryButton}" HorizontalAlignment="Center" />
            </StackPanel>
            <Grid x:Name="HomePreviewBadges" VerticalAlignment="Top" Margin="14" ColumnSpacing="10">
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <ContentControl x:Name="HomeHeroBadge" Style="{StaticResource HomePreviewBadge}" HorizontalAlignment="Left">
              <TextBlock x:Name="HeroLabel" Text="{local:UiString Source='视频封面'}" FontSize="12" FontWeight="Black" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" />
             </ContentControl>
             <ContentControl x:Name="HomePlaybackBadge" Grid.Column="1" Style="{StaticResource HomePreviewBadge}" HorizontalAlignment="Right" MaxWidth="350">
              <TextBlock x:Name="PlaybackStatus" Text="{local:UiString Source='等待添加素材'}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="#DFE8AF" FontSize="12" VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" />
