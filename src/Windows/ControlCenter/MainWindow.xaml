       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Viewbox Width="22" Height="22" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
        <Path Width="24" Height="24" Stretch="None" Data="F0 M4,3 L20,3 Q22,3 22,5 L22,16 Q22,18 20,18 L14,18 L14,20 L18,20 L18,23 L6,23 L6,20 L10,20 L10,18 L4,18 Q2,18 2,16 L2,5 Q2,3 4,3 Z M6,7 L6,14 L18,14 L18,7 Z" Fill="{Binding Foreground, ElementName=EffectsTargetScreenButton}"/>
       </Viewbox>
       <TextBlock x:Name="EffectsTargetScreenLabel" Grid.Column="1" Text="{local:UiString Source='显示器'}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}"/>
       <Path x:Name="EffectsTargetScreenCheck" Grid.Column="2" Data="M 1,8 L 4,5 L 7,8 L 14,1 L 17,4 L 7,14 Z" Width="17" Height="14" Stretch="Uniform" Fill="{StaticResource InteractionAccentBrush}" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
      </Grid>
     </Button>
     <Grid Grid.Row="2" ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
      <TextBox x:Name="EffectsTargetSearch" PlaceholderText="{local:UiString Source='搜索素材'}" Style="{StaticResource UtilityTextBox}" TextChanged="EffectsTargetSearch_Changed" KeyDown="EffectsTargetSearch_KeyDown" AutomationProperties.Name="{local:UiString Source='搜索作用对象素材'}"/>
      <ComboBox x:Name="EffectsTargetType" Grid.Column="1" SelectedIndex="0" Style="{StaticResource UtilityComboBox}" SelectionChanged="EffectsTargetType_Changed" AutomationProperties.Name="{local:UiString Source='筛选素材类型'}">
       <ComboBoxItem Content="{local:UiString Source='全部素材'}"/><ComboBoxItem Content="{local:UiString Source='视频'}"/><ComboBoxItem Content="{local:UiString Source='图片'}"/>
      </ComboBox>
     </Grid>
     <Grid Grid.Row="3">
      <GridView x:Name="EffectsTargetList" Style="{StaticResource LibraryGridView}" ItemContainerStyle="{StaticResource LibraryGridViewItem}" ItemTemplate="{StaticResource LibraryAssetCard}" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False" IsItemClickEnabled="True" IsTabStop="True" ItemClick="EffectsTargetAsset_Click" Loaded="EffectsTargetGrid_Loaded" SizeChanged="EffectsTargetGrid_SizeChanged" Padding="0,0,4,8" AutomationProperties.Name="{local:UiString Source='可选素材'}"/>
      <TextBlock x:Name="EffectsTargetEmpty" Text="{local:UiString Source='暂无素材'}" Style="{StaticResource UtilityHint}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False"/>
     </Grid>
    </Grid>
   </ContentControl>
  </Grid>
  <Grid Grid.Row="1" x:Name="QueueOverlay" Visibility="Collapsed">
   <Button x:Name="QueueScrim" local:InteractionFocus.SuppressFeedback="True" Background="#99000000" BorderThickness="0" CornerRadius="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False" UseSystemFocusVisuals="False" Click="QueueClose_Click" AutomationProperties.Name="{local:UiString Source='关闭播放队列'}" Style="{x:Null}">
    <Button.Template>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" />
     </ControlTemplate>
    </Button.Template>
   </Button>
   <ContentControl x:Name="QueueDrawer" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1040" Height="720" Margin="24" Padding="24" Style="{StaticResource HomeFrame}">
    <Grid RowSpacing="14" TabFocusNavigation="Cycle">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{local:UiString Source='播放队列'}" FontSize="28" FontWeight="Black" FontStyle="Italic" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
      <Button x:Name="QueueCloseButton" Grid.Column="1" Click="QueueClose_Click" AutomationProperties.Name="{local:UiString Source='关闭播放队列'}" Style="{StaticResource ModalCloseButton}">
       <PathIcon Data="F0 M5,2 L12,9 L19,2 L22,5 L15,12 L22,19 L19,22 L12,15 L5,22 L2,19 L9,12 L2,5 Z" Width="20" Height="20" />
      </Button>
     </Grid>
     <ScrollViewer x:Name="HomeQueueScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Style="{StaticResource HomeScrollViewer}">
      <Grid x:Name="QueueWorkspace" Height="{Binding ViewportHeight, ElementName=HomeQueueScroll}" MinHeight="360" RowSpacing="12" SizeChanged="QueueWorkspace_SizeChanged">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="PlaybackSourcePicker" Height="40" HorizontalAlignment="Stretch" PlaceholderText="{local:UiString Source='选择播放列表'}" AutomationProperties.Name="{local:UiString Source='播放列表来源'}" SelectionChanged="PlaybackSource_Changed" Style="{StaticResource HomeComboBox}">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontFamily="{StaticResource BodyFont}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="PlaybackNewPlaylistButton" Grid.Column="1" Content="{local:UiString Source='新建列表'}" Click="PlaybackNewPlaylist_Click" Height="40" MaxHeight="40" Padding="14,0" Style="{StaticResource HomeCompactButton}" AutomationProperties.Name="{local:UiString Source='新建自定义播放列表'}" />
       </Grid>
       <Border Grid.Row="1" Background="#0B0B0B" BorderBrush="#303030" BorderThickness="1" CornerRadius="16" Padding="8">
        <Grid RowSpacing="6">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Grid ColumnSpacing="8" RowSpacing="4" Margin="6,0,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="PlaybackQueueSummary" FontSize="12" Foreground="#AFAFAF" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource BodyFont}" VerticalAlignment="Center" />
          <StackPanel x:Name="PlaybackCustomActions" Grid.Column="1" Orientation="Horizontal" Spacing="4">
           <Button x:Name="PlaybackClearInvalidButton" Click="PlaybackClearInvalid_Click" Height="32" MinWidth="0" Padding="10,0" FontSize="12" Style="{StaticResource HomeCompactButton}" AutomationProperties.Name="{local:UiString Source='清除库内引用已移除的队列项'}">
            <TextBlock Text="{local:UiString Source='清除失效项'}" TextLineBounds="Full" VerticalAlignment="Center" />
           </Button>
           <Button x:Name="PlaybackUpButton" Content="{local:UiString Source='上移'}" Click="PlaybackUp_Click" Height="32" MinWidth="0" Padding="10,0" FontSize="12" Style="{StaticResource HomeCompactButton}" />
           <Button x:Name="PlaybackDownButton" Content="{local:UiString Source='下移'}" Click="PlaybackDown_Click" Height="32" MinWidth="0" Padding="10,0" FontSize="12" Style="{StaticResource HomeCompactButton}" />
           <Button x:Name="PlaybackRemoveButton" Content="{local:UiString Source='移除'}" Click="PlaybackRemove_Click" Height="32" MinWidth="0" Padding="10,0" FontSize="12" Style="{StaticResource HomeCompactButton}" />
           <Button x:Name="PlaybackMoreButton" Width="32" Height="32" MinWidth="0" Padding="0" Style="{StaticResource HomeIconButton}" AutomationProperties.Name="{local:UiString Source='更多队列操作'}">
            <Viewbox Width="18" Height="4" IsHitTestVisible="False"><Grid Width="18" Height="4"><Ellipse Width="4" Height="4" HorizontalAlignment="Left" Fill="{Binding Foreground, ElementName=PlaybackMoreButton}"/><Ellipse Width="4" Height="4" HorizontalAlignment="Center" Fill="{Binding Foreground, ElementName=PlaybackMoreButton}"/><Ellipse Width="4" Height="4" HorizontalAlignment="Right" Fill="{Binding Foreground, ElementName=PlaybackMoreButton}"/></Grid></Viewbox>
            <Button.Flyout><MenuFlyout MenuFlyoutPresenterStyle="{StaticResource HomeMenuFlyoutPresenter}">
             <MenuFlyoutItem x:Name="PlaybackAddSelectedButton" Text="{local:UiString Source='加入选中素材'}" Click="PlaybackAddSelected_Click" Style="{StaticResource HomeMenuFlyoutItem}" />
             <MenuFlyoutItem x:Name="PlaybackAddAllButton" Text="{local:UiString Source='加入库内全部素材'}" Click="PlaybackAddAll_Click" Style="{StaticResource HomeMenuFlyoutItem}" />
             <MenuFlyoutItem Text="{local:UiString Source='前往素材库'}" Tag="library" Click="MenuNavigate_Click" Style="{StaticResource HomeMenuFlyoutItem}" />
             <MenuFlyoutSeparator/>
             <MenuFlyoutItem x:Name="PlaybackRenamePlaylistButton" Text="{local:UiString Source='重命名列表'}" Click="PlaybackRenamePlaylist_Click" Style="{StaticResource HomeMenuFlyoutItem}" />
             <MenuFlyoutItem x:Name="PlaybackClearButton" Text="{local:UiString Source='清空列表'}" Click="PlaybackClear_Click" Style="{StaticResource HomeMenuFlyoutItem}" />
             <MenuFlyoutItem x:Name="PlaybackDeletePlaylistButton" Text="{local:UiString Source='删除列表'}" Click="PlaybackDeletePlaylist_Click" Style="{StaticResource HomeMenuFlyoutItem}" />
            </MenuFlyout></Button.Flyout>
           </Button>
          </StackPanel>
         </Grid>
         <ListView x:Name="PlaybackQueueList" Grid.Row="1" SelectionMode="Single" SelectionChanged="PlaybackQueue_Changed" ItemContainerStyle="{StaticResource LibraryQueueItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:UiString Source='播放队列视频列表'}">
          <ListView.Resources><ResourceDictionary>
           <Style TargetType="ScrollViewer" BasedOn="{StaticResource HomeScrollViewer}" />
          </ResourceDictionary></ListView.Resources>
          <ListView.ItemTemplate><DataTemplate>
           <Grid Padding="8" ColumnSpacing="12" AutomationProperties.HelpText="{Binding Asset.Path}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="Bold" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" />
            <Border Grid.Column="1" Width="80" Height="46" Background="#222222" CornerRadius="6">
             <Grid><FontIcon Glyph="&#xE714;" FontSize="20" Foreground="#777777"/>
              <Image Stretch="UniformToFill" Source="{Binding Poster}"/>
             </Grid>
            </Border>
            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
             <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource BodyFont}" />
             <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource BodyFont}" />
            </StackPanel>
           </Grid>
          </DataTemplate></ListView.ItemTemplate>
         </ListView>
         <StackPanel x:Name="PlaybackQueueEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="12">
          <TextBlock Text="{local:UiString Source='队列为空'}" FontSize="20" FontWeight="Black" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" />
          <Button Content="{local:UiString Source='前往素材库'}" Tag="library" Click="Nav_Click" Height="36" MaxHeight="36" Padding="16,0" HorizontalAlignment="Center" Style="{StaticResource HomeCompactButton}" />
         </StackPanel>
        </Grid>
       </Border>
       <Grid x:Name="QueueFooter" Grid.Row="2" ColumnSpacing="16" RowSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="QueueNowPlaying" Spacing="4" VerticalAlignment="Center">
         <TextBlock x:Name="PlaybackCurrentText" FontSize="12" Foreground="#47DDE7" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource BodyFont}" />
         <TextBlock x:Name="PlaybackPlanStatus" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource BodyFont}" />
        </StackPanel>
        <StackPanel x:Name="QueueTransport" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
         <Button x:Name="PlaybackPreviousButton" Click="PlaybackPrevious_Click" Width="40" Height="44" MinHeight="44" MaxHeight="44" MinWidth="0" Padding="0" Style="{StaticResource HomeCompactButton}" AutomationProperties.Name="{local:UiString Source='上一段'}">
          <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Grid Width="24" Height="24"><Path Data="F0 M3,4 H7 V20 H3 Z M21,3 V21 L8,12 Z" Fill="{Binding Foreground, ElementName=PlaybackPreviousButton}"/></Grid></Viewbox>
         </Button>
         <Button x:Name="PlaybackNextButton" Click="PlaybackNext_Click" Width="40" Height="44" MinHeight="44" MaxHeight="44" MinWidth="0" Padding="0" Style="{StaticResource HomeCompactButton}" AutomationProperties.Name="{local:UiString Source='下一段'}">
          <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><Grid Width="24" Height="24"><Path Data="F0 M17,4 H21 V20 H17 Z M3,3 L16,12 L3,21 Z" Fill="{Binding Foreground, ElementName=PlaybackNextButton}"/></Grid></Viewbox>
         </Button>
         <Button x:Name="PlayQueueButton" Click="PlayQueue_Click" Height="44" MinHeight="44" MaxHeight="44" MinWidth="136" CornerRadius="22" FontSize="14" Padding="18,0" Style="{StaticResource HomePrimaryButton}" AutomationProperties.Name="{local:UiString Source='应用播放队列'}">
          <TextBlock Text="{local:UiString Source='应用播放队列'}" TextLineBounds="Full" VerticalAlignment="Center" HorizontalAlignment="Center"/>
         </Button>
        </StackPanel>
       </Grid>
      </Grid>
     </ScrollViewer>
    </Grid>
   </ContentControl>
  </Grid>
  <Grid Grid.Row="1" x:Name="WidgetDrawerOverlay" Visibility="Collapsed" KeyDown="WidgetDrawer_KeyDown">
   <Button local:InteractionFocus.SuppressFeedback="True" Background="#99000000" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="WidgetDrawerClose_Click" IsTabStop="False" UseSystemFocusVisuals="False" AutomationProperties.Name="{local:UiString Source='关闭组件窗口'}" Style="{x:Null}">
    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Button.Template>
   </Button>
   <ContentControl x:Name="WidgetDrawer" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1040" Height="720" Margin="24" Padding="0" Style="{StaticResource HomeFrame}">
    <Grid CornerRadius="16" Background="Transparent">
     <Canvas x:Name="ColorDriveBackdrop" IsHitTestVisible="False" Visibility="Collapsed" SizeChanged="ColorDriveBackdrop_SizeChanged">
      <Canvas.Clip><RectangleGeometry x:Name="ColorDriveBackdropClip"/></Canvas.Clip>
      <Path x:Name="ColorDriveStripes" Stroke="#0BFFFFFF" StrokeThickness="3"/>
      <Path x:Name="ColorDriveDots" Fill="#18FFFFFF"/>
     </Canvas>
    <Grid x:Name="WidgetDrawerLayout" Margin="24" RowSpacing="16" TabFocusNavigation="Cycle">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center">
       <TextBlock x:Name="WidgetDrawerTitle" FontSize="24" FontFamily="{StaticResource DisplayFont}"/>
       <TextBlock x:Name="WidgetDrawerSubtitle" FontSize="11" FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource HomeControlMuted}" CharacterSpacing="160" Visibility="Collapsed"/>
      </StackPanel>
      <Button x:Name="WidgetDrawerCloseButton" Grid.Column="1" Click="WidgetDrawerClose_Click" Style="{StaticResource ModalCloseButton}" AutomationProperties.Name="{local:UiString Source='关闭组件窗口'}">
       <Viewbox Width="18" Height="18"><Path Width="24" Height="24" Stretch="None" Data="F0 M5,2 L12,9 L19,2 L22,5 L15,12 L22,19 L19,22 L12,15 L5,22 L2,19 L9,12 L2,5 Z" Fill="{Binding Foreground, ElementName=WidgetDrawerCloseButton}"/></Viewbox>
      </Button>
     </Grid>
     <ScrollViewer x:Name="WidgetDrawerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource HomeScrollViewer}"><StackPanel x:Name="WidgetDrawerContent" Spacing="16"/></ScrollViewer>
    </Grid>
    </Grid>
   </ContentControl>
  </Grid>
  <TextBlock x:Name="FooterStatus" Visibility="Collapsed" FontFamily="{StaticResource BodyFont}" />
  <TextBlock x:Name="EffectsDraftStatus" Visibility="Collapsed" FontFamily="{StaticResource BodyFont}" />
  <TextBlock x:Name="PlaybackEffectTargetText" Visibility="Collapsed" FontFamily="{StaticResource BodyFont}" />
 </Grid>
 </Viewbox>
 </Grid>
</Window>

