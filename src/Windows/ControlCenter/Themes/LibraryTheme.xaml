                </VisualState>
                <VisualState x:Name="SecondaryAsDefaultButton">
                  <VisualState.Setters>
                    <Setter Target="SecondaryButton.Style" Value="{StaticResource LibraryDialogPrimaryButton}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CloseAsDefaultButton">
                  <VisualState.Setters>
                    <Setter Target="CloseButton.Style" Value="{StaticResource LibraryDialogPrimaryButton}" />
                  </VisualState.Setters>
                </VisualState>
