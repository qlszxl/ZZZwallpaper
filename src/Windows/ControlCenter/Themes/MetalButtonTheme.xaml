<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LumaWall.ControlCenter">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Default">
   <LinearGradientBrush x:Key="MetalFaceBrush" StartPoint="0,0" EndPoint="0.16,1">
    <GradientStop Color="#FAFBFA" Offset="0"/><GradientStop Color="#E4E6E5" Offset="0.24"/>
    <GradientStop Color="#F1F2F1" Offset="0.58"/><GradientStop Color="#D1D5D6" Offset="1"/>
   </LinearGradientBrush>
   <SolidColorBrush x:Key="MetalTextBrush" Color="#141516"/>
   <SolidColorBrush x:Key="MetalAccentBrush" Color="#FF7900"/>
   <LinearGradientBrush x:Key="MetalEdgeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#E9EBEB" Offset="0.42"/>
    <GradientStop Color="#8D969B" Offset="1"/>
   </LinearGradientBrush>
   <SolidColorBrush x:Key="MetalFocusBrush" Color="#FF7900"/>
   <SolidColorBrush x:Key="MetalFocusContrastBrush" Color="#242424"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="MetalFaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
   <SolidColorBrush x:Key="MetalTextBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
   <SolidColorBrush x:Key="MetalAccentBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
   <SolidColorBrush x:Key="MetalEdgeBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
   <SolidColorBrush x:Key="MetalFocusBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
   <SolidColorBrush x:Key="MetalFocusContrastBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <!-- Theme dictionaries are materialized before sibling App resources exist.
      Keep this font in the same dictionary as the custom button style. -->
 <FontFamily x:Key="MetalDisplayFont">ms-appx:///Assets/Fonts/SourceHanSansSC-Heavy.otf#Source Han Sans SC</FontFamily>
 <LinearGradientBrush x:Key="MetalWatermarkBrush" StartPoint="0,0.8" EndPoint="1,0.2">
  <GradientStop Color="#244A5258" Offset="0"/><GradientStop Color="#384A5258" Offset="0.34"/>
  <GradientStop Color="#1B4A5258" Offset="0.57"/><GradientStop Color="#304A5258" Offset="1"/>
 </LinearGradientBrush>
 <Style x:Key="MetalAddButtonStyle" TargetType="local:MetalAddButton">
  <Setter Property="local:InteractionFocus.SuppressFeedback" Value="True"/>
  <Setter Property="UseSystemFocusVisuals" Value="False"/>
  <Setter Property="MinHeight" Value="76"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Padding" Value="22,18"/><Setter Property="FontSize" Value="20"/>
  <Setter Property="FontFamily" Value="{StaticResource MetalDisplayFont}"/><Setter Property="FontWeight" Value="Black"/>
  <Setter Property="Foreground" Value="{ThemeResource MetalTextBrush}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:MetalAddButton">
   <Grid x:Name="MetalRoot" Background="Transparent">
    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
     <VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/>
     <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="MetalRoot.Opacity" Value="0.46"/></VisualState.Setters></VisualState>
    </VisualStateGroup></VisualStateManager.VisualStateGroups>
    <Border x:Name="MetalFace" Margin="2" CornerRadius="10" Background="{ThemeResource MetalFaceBrush}" BorderThickness="1" BorderBrush="{ThemeResource MetalEdgeBrush}"/>
    <local:MetalMaterial x:Name="Material" Margin="3" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
    <local:MetalDecorationLayer x:Name="WatermarkRegion" Margin="3" HorizontalAlignment="Right" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
     <Canvas>
      <Viewbox x:Name="WatermarkScale" Stretch="Fill">
       <TextBlock x:Name="Watermark" Text="{TemplateBinding BackdropText}" FontFamily="ms-appx:///Assets/Fonts/SairaCondensed-Black.ttf#Saira Condensed" FontWeight="Black" FontSize="112" Foreground="{StaticResource MetalWatermarkBrush}" IsTextScaleFactorEnabled="False"/>
      </Viewbox>
     </Canvas>
    </local:MetalDecorationLayer>
    <Border x:Name="PressedShade" Margin="3" CornerRadius="9" Background="#19232A" Opacity="0" IsHitTestVisible="False"/>
    <Grid x:Name="LabelRow" Margin="{TemplateBinding Padding}" ColumnSpacing="16" IsHitTestVisible="False">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Path Width="25" Height="25" Stretch="Uniform" Data="M8,0 H17 V8 H25 V17 H17 V25 H8 V17 H0 V8 H8 Z" Fill="{ThemeResource MetalAccentBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
     <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
    </Grid>
    <Border x:Name="FocusContrast" Margin="0" CornerRadius="12" BorderBrush="{ThemeResource MetalFocusContrastBrush}" BorderThickness="4" Opacity="0" IsHitTestVisible="False"/>
    <Border x:Name="FocusRing" Margin="1" CornerRadius="11" BorderBrush="{ThemeResource MetalFocusBrush}" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
