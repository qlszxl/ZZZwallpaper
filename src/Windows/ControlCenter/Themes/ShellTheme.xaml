<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:LumaWall.ControlCenter">
 <!-- This custom-control dictionary must load on its own. Do not resolve
      caption resources through sibling dictionaries during template loading. -->
 <SolidColorBrush x:Key="ShellCaptionText" Color="#F0F0F0"/>

 <SolidColorBrush x:Key="ShellCaptionHover" Color="#363636"/>
 <SolidColorBrush x:Key="ShellCaptionPressed" Color="#202020"/>
 <LinearGradientBrush x:Key="ShellCaptionRim" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#2D2D2D" Offset="0"/><GradientStop Color="#171717" Offset="0.46"/><GradientStop Color="#242424" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="ShellCaptionWell" StartPoint="0,0" EndPoint="0,1">
  <GradientStop Color="#070707" Offset="0"/><GradientStop Color="#141414" Offset="0.30"/><GradientStop Color="#1E1E1E" Offset="1"/>
 </LinearGradientBrush>
 <Style x:Key="ShellCaptionButton" TargetType="local:WindowCaptionButton">
    <Setter Property="local:InteractionFocus.Enabled" Value="True" />
  <Setter Property="Width" Value="46"/><Setter Property="Height" Value="42"/>
  <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
  <Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{StaticResource ShellCaptionText}"/>
  <Setter Property="Background" Value="{StaticResource ShellCaptionWell}"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="UseSystemFocusVisuals" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:WindowCaptionButton">
   <Border x:Name="CaptionRim" Background="{StaticResource ShellCaptionRim}" Padding="2" CornerRadius="14" local:InteractionFocus.Surface="True">
    <VisualStateManager.VisualStateGroups>
     <VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters>
       <Setter Target="CaptionFace.Background" Value="{StaticResource ShellCaptionHover}"/>
       
      </VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters>
       <Setter Target="CaptionFace.Background" Value="{StaticResource ShellCaptionPressed}"/>
      </VisualState.Setters></VisualState>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="CaptionRim.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="FocusStates">
      <VisualState x:Name="Unfocused"/><VisualState x:Name="PointerFocused"/>
      <VisualState x:Name="Focused"><VisualState.Setters></VisualState.Setters></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="GlyphStates">
      <VisualState x:Name="Minimize"/>
      <VisualState x:Name="Maximize"><VisualState.Setters><Setter Target="CaptionMinimize.Visibility" Value="Collapsed"/><Setter Target="CaptionMaximize.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Restore"><VisualState.Setters><Setter Target="CaptionMinimize.Visibility" Value="Collapsed"/><Setter Target="CaptionRestore.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Close"><VisualState.Setters><Setter Target="CaptionMinimize.Visibility" Value="Collapsed"/><Setter Target="CaptionClose.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Border Background="#020202" Padding="1" CornerRadius="12">
     <Border x:Name="CaptionFace" Background="{TemplateBinding Background}" BorderBrush="#333333" BorderThickness="1" CornerRadius="11">
      <!-- All glyphs use one fixed 24-DIP viewport, including the thin minimize line. -->
      <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
       <!-- Inline Data creates geometry owned only by this template's Path. -->
       <Path x:Name="CaptionMinimize" Data="M5,11 L19,11 L19,13 L5,13 Z" Stretch="None" Fill="{TemplateBinding Foreground}"/>
       <Path x:Name="CaptionMaximize" Data="F0 M4,4 L20,4 L20,20 L4,20 Z M6,6 L6,18 L18,18 L18,6 Z" Stretch="None" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"/>
       <Path x:Name="CaptionRestore" Data="F0 M3,7 L17,7 L17,21 L3,21 Z M5,9 L5,19 L15,19 L15,9 Z M7,3 L21,3 L21,17 L19,17 L19,5 L7,5 Z" Stretch="None" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"/>
       <Path x:Name="CaptionClose" Data="M6,4 L12,10 L18,4 L20,6 L14,12 L20,18 L18,20 L12,14 L6,20 L4,18 L10,12 L4,6 Z" Stretch="None" Fill="{TemplateBinding Foreground}" Visibility="Collapsed"/>
      </Grid>
     </Border>
    </Border>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
