<ResourceDictionary xmlns:local="using:LumaWall.ControlCenter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="UtilityCard" TargetType="ContentControl" BasedOn="{StaticResource EffectsSection}" />
 <Style x:Key="ParameterSectionCard" TargetType="ContentControl" BasedOn="{StaticResource EffectsSection}">
  <Setter Property="CornerRadius" Value="24" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Border Background="{StaticResource HomeRimBrush}" Padding="4" CornerRadius="24">
    <Border Background="{StaticResource HomeFrameSeparatorBrush}" Padding="3" CornerRadius="20">
     <Border Background="{StaticResource HomeFrameEdgeBrush}" Padding="1" CornerRadius="17">
      <Grid Background="{StaticResource HomeWellBrush}" CornerRadius="16">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ContentPresenter Content="{Binding Path=(local:SectionChrome.Header), RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding Path=(local:SectionChrome.HeaderVisibility), RelativeSource={RelativeSource TemplatedParent}}" Margin="{Binding Path=(local:SectionChrome.HeaderMargin), RelativeSource={RelativeSource TemplatedParent}}" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" />
        <ContentPresenter Grid.Row="1" Margin="{Binding Path=(local:SectionChrome.BodyMargin), RelativeSource={RelativeSource TemplatedParent}}" TextLineBounds="Full" Content="{TemplateBinding Content}" Visibility="{Binding Path=(local:SectionChrome.BodyVisibility), RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="{TemplateBinding FontSize}" />
       </Grid>
      </Grid>
     </Border>
    </Border>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="UtilityHeading" TargetType="TextBlock" BasedOn="{StaticResource EffectsHeading}"><Setter Property="local:ParameterHint.Enabled" Value="True" /></Style>
 <Style x:Key="UtilityLabel" TargetType="TextBlock" BasedOn="{StaticResource EffectsParameterLabel}" />
 <Style x:Key="UtilityHint" TargetType="TextBlock" BasedOn="{StaticResource EffectsHint}" />
 <Style x:Key="UtilityButton" TargetType="Button" BasedOn="{StaticResource HomeButton}">
    <Setter Property="local:InteractionFocus.Enabled" Value="True" />
  <Setter Property="MinHeight" Value="44" />
  <Setter Property="Padding" Value="12,0" />
  <Setter Property="FontSize" Value="14" />
  <Setter Property="HorizontalContentAlignment" Value="Center" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
 </Style>
 <Style x:Key="UtilityPrimaryButton" TargetType="Button" BasedOn="{StaticResource UtilityButton}">
    <Setter Property="local:InteractionFocus.Enabled" Value="True" />
  
  
 </Style>
 <Style x:Key="ParameterSectionToggle" TargetType="Button" BasedOn="{StaticResource UtilityButton}">
  <Setter Property="Padding" Value="6,0"/><Setter Property="CornerRadius" Value="6"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" local:InteractionFocus.Surface="True">
    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="CompactHelpButton" TargetType="Button" BasedOn="{StaticResource ParameterSectionToggle}">
  <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
  <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
  <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="8"/>
 </Style>
 <Style x:Key="ModalCloseButton" TargetType="Button" BasedOn="{StaticResource UtilityButton}">
    <Setter Property="local:InteractionFocus.Enabled" Value="True" />
  <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
  <Setter Property="MinWidth" Value="40"/><Setter Property="MinHeight" Value="40"/>
  <Setter Property="MaxWidth" Value="40"/><Setter Property="MaxHeight" Value="40"/>
  <Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="20"/>
 </Style>
 <Style x:Key="UtilityComboBox" TargetType="ComboBox" BasedOn="{StaticResource HomeComboBox}">
    <Setter Property="local:InteractionFocus.Enabled" Value="True" />
  <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
  <Setter Property="FontWeight" Value="Medium" />
  <Setter Property="FontSize" Value="14" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="VerticalAlignment" Value="Center" />
 </Style>
 <!-- Keep native ComboBox popup measurement: CarouselPanel reports the popup
      border/padding to ArrangePopup. No inner height cap or MaxHeight callback
      may compete with that measurement. The selected label remains independent
      of the native ContentPresenter, which is cleared when the popup opens. -->
 <Style x:Key="StringChoiceComboBox" TargetType="ComboBox" BasedOn="{StaticResource UtilityComboBox}">
    <Setter Property="local:InteractionFocus.Enabled" Value="True" />
  <Setter Property="ItemsPanel">
   <Setter.Value><ItemsPanelTemplate><CarouselPanel /></ItemsPanelTemplate></Setter.Value>
  </Setter>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid x:Name="LayoutRoot" Background="Transparent">
      <VisualStateManager.VisualStateGroups>
       <VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal" />
        <VisualState x:Name="PointerOver">
         <VisualState.Setters>
          <Setter Target="Background.Background" Value="{StaticResource HomeControlSurfaceHover}" />
          <Setter Target="Background.BorderBrush" Value="{StaticResource HomeControlEdgeLight}" />
         </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Pressed">
         <VisualState.Setters><Setter Target="Background.Background" Value="{StaticResource HomeControlSurfacePressed}" /></VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Disabled">
         <VisualState.Setters>
          <Setter Target="SelectedText.Foreground" Value="{StaticResource HomeControlDisabled}" />
          <Setter Target="DropDownGlyph.Fill" Value="{StaticResource HomeControlDisabled}" />
         </VisualState.Setters>
        </VisualState>
       </VisualStateGroup>
       <VisualStateGroup x:Name="FocusStates">
        <VisualState x:Name="Unfocused" />
        <VisualState x:Name="Focused"><VisualState.Setters></VisualState.Setters></VisualState>
        <VisualState x:Name="FocusedPressed"><VisualState.Setters></VisualState.Setters></VisualState>
        <VisualState x:Name="PointerFocused"><VisualState.Setters></VisualState.Setters></VisualState>
        <VisualState x:Name="FocusedDropDown"><VisualState.Setters></VisualState.Setters></VisualState>
       </VisualStateGroup>
       <VisualStateGroup x:Name="DropDownStates">
        <VisualState x:Name="Opened" />
        <VisualState x:Name="Closed" />
       </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
      <Border x:Name="Background" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Control.IsTemplateFocusTarget="True" local:InteractionFocus.Surface="True" />
      <!-- Retain the native part for ComboBox layout and selection mechanics.
           Its parent stays invisible; the visible label has its own binding. -->
      <Grid Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
       <ContentPresenter x:Name="ContentPresenter" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
        <TextBlock x:Name="PlaceholderTextBlock" Text="{TemplateBinding PlaceholderText}" />
       </ContentPresenter>
      </Grid>
      <TextBlock x:Name="SelectedText" Text="{Binding SelectedItem.Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
      <Path x:Name="DropDownGlyph" Grid.Column="1" Width="14" Height="9" Stretch="Uniform" Data="M0,0 L7,6 L14,0 L14,4 L7,10 L0,4 Z" Fill="{StaticResource HomeControlText}" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
      <Popup x:Name="Popup">
       <Border x:Name="PopupBorder" Background="#171717" BorderBrush="#2D2D2D" BorderThickness="1" Margin="0,6,0,6" Padding="5" CornerRadius="16">
        <ScrollViewer x:Name="ScrollViewer" Style="{StaticResource HomeScrollViewer}" Foreground="{StaticResource HomeControlText}" MinWidth="{Binding TemplateSettings.DropDownContentMinWidth, RelativeSource={RelativeSource TemplatedParent}}" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="True" ZoomMode="Disabled" AutomationProperties.AccessibilityView="Raw">
         <ItemsPresenter Margin="{ThemeResource ComboBoxDropdownContentMargin}" />
        </ScrollViewer>
       </Border>
      </Popup>
     </Grid>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="AudioRuleComboBox" TargetType="ComboBox" BasedOn="{StaticResource StringChoiceComboBox}" >
    <Setter Property="local:InteractionFocus.Enabled" Value="True" />
  </Style>
 <Style x:Key="UtilityTextBox" TargetType="TextBox" BasedOn="{StaticResource HomeNumberBoxTextBox}">
  <Setter Property="local:DoubleClickEdit.Enabled" Value="True"/>
    <Setter Property="local:InteractionFocus.Enabled" Value="True" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
  <Setter Property="FontWeight" Value="Medium" />
  <Setter Property="FontSize" Value="14" />
  <Setter Property="Foreground" Value="{StaticResource HomeControlText}" />
  <Setter Property="Background" Value="{StaticResource HomeControlRecess}" />
  <Setter Property="BorderBrush" Value="{StaticResource HomeControlInnerEdge}" />
  <Setter Property="BorderThickness" Value="2" />
  <Setter Property="CornerRadius" Value="16" />
  <Setter Property="Padding" Value="12,0" />
  <Setter Property="MinHeight" Value="44" />
  <Setter Property="Height" Value="44" />
  <Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="SelectionHighlightColor" Value="{StaticResource InteractionTextSelectionBrush}" />
 </Style>
 <!-- Sharing keeps the app's recessed material; only the small check well carries selection color. -->
 <Style x:Key="SharingSelectionCheckBox" TargetType="CheckBox" BasedOn="{StaticResource LibraryCheckBox}">
  <Setter Property="CornerRadius" Value="20"/><Setter Property="BorderThickness" Value="3"/>
  <Setter Property="Padding" Value="14,10"/><Setter Property="MinHeight" Value="64"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid x:Name="RootGrid">
    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CombinedStates">
     <VisualState x:Name="UncheckedNormal"></VisualState>
     <VisualState x:Name="UncheckedPointerOver"><VisualState.Setters><Setter Target="TileInnerEdge.Background" Value="{StaticResource HomeFrameEdgeHoverBrush}"/></VisualState.Setters></VisualState>
     <VisualState x:Name="UncheckedPressed"><VisualState.Setters><Setter Target="TileInnerEdge.Opacity" Value="0.72"/></VisualState.Setters></VisualState>
     <VisualState x:Name="UncheckedDisabled"><VisualState.Setters><Setter Target="RootGrid.Opacity" Value="0.36"/></VisualState.Setters></VisualState>
     <VisualState x:Name="CheckedNormal"><VisualState.Setters><Setter Target="SelectionMark.Background" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="SelectionMark.BorderBrush" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="CheckGlyph.Opacity" Value="1"/></VisualState.Setters></VisualState>
     <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="SelectionMark.Background" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="SelectionMark.BorderBrush" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="CheckGlyph.Opacity" Value="1"/><Setter Target="TileInnerEdge.Background" Value="{StaticResource HomeFrameEdgeHoverBrush}"/></VisualState.Setters></VisualState>
     <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="SelectionMark.Background" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="SelectionMark.BorderBrush" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="CheckGlyph.Opacity" Value="1"/><Setter Target="TileInnerEdge.Opacity" Value="0.72"/></VisualState.Setters></VisualState>
     <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="SelectionMark.Background" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="SelectionMark.BorderBrush" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="CheckGlyph.Opacity" Value="1"/><Setter Target="RootGrid.Opacity" Value="0.36"/></VisualState.Setters></VisualState>
     <VisualState x:Name="IndeterminateNormal"><VisualState.Setters><Setter Target="SelectionMark.Background" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="SelectionMark.BorderBrush" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="IndeterminateGlyph.Opacity" Value="1"/></VisualState.Setters></VisualState>
     <VisualState x:Name="IndeterminatePointerOver"><VisualState.Setters><Setter Target="SelectionMark.Background" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="SelectionMark.BorderBrush" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="IndeterminateGlyph.Opacity" Value="1"/><Setter Target="TileInnerEdge.Background" Value="{StaticResource HomeFrameEdgeHoverBrush}"/></VisualState.Setters></VisualState>
     <VisualState x:Name="IndeterminatePressed"><VisualState.Setters><Setter Target="SelectionMark.Background" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="SelectionMark.BorderBrush" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="IndeterminateGlyph.Opacity" Value="1"/><Setter Target="TileInnerEdge.Opacity" Value="0.72"/></VisualState.Setters></VisualState>
     <VisualState x:Name="IndeterminateDisabled"><VisualState.Setters><Setter Target="SelectionMark.Background" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="SelectionMark.BorderBrush" Value="{StaticResource InteractionAccentBrush}"/><Setter Target="IndeterminateGlyph.Opacity" Value="1"/><Setter Target="RootGrid.Opacity" Value="0.36"/></VisualState.Setters></VisualState>
    </VisualStateGroup></VisualStateManager.VisualStateGroups>
    <Border x:Name="TileRim" Background="{TemplateBinding BorderBrush}" Padding="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" local:InteractionFocus.Surface="True">
     <Border Background="{StaticResource HomeFrameSeparatorBrush}" Padding="2" CornerRadius="{Binding CornerRadius, ElementName=TileRim, Converter={StaticResource HomeInsetCorner}, ConverterParameter=3}">
      <Border x:Name="TileInnerEdge" Background="{StaticResource HomeFrameEdgeBrush}" Padding="1" CornerRadius="{Binding CornerRadius, ElementName=TileRim, Converter={StaticResource HomeInsetCorner}, ConverterParameter=5}">
       <Grid Background="{TemplateBinding Background}" CornerRadius="{Binding CornerRadius, ElementName=TileRim, Converter={StaticResource HomeInsetCorner}, ConverterParameter=6}">
        <Grid Margin="{TemplateBinding Padding}" ColumnSpacing="16">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
         <ContentPresenter x:Name="ContentPresenter" TextLineBounds="Full" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" TextWrapping="Wrap"/>
         <Border x:Name="SelectionMark" Grid.Column="1" Width="20" Height="20" Background="{StaticResource HomeControlRecess}" BorderBrush="{StaticResource HomeFrameEdgeHoverBrush}" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center" IsHitTestVisible="False">
          <Grid>
           <Path x:Name="CheckGlyph" Width="12" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource HomeControlInk}" Data="M 1,8 L 4,5 L 7,8 L 14,1 L 17,4 L 7,14 Z" Opacity="0"/>
           <Rectangle x:Name="IndeterminateGlyph" Width="10" Height="3" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource HomeControlInk}" Opacity="0"/>
          </Grid>
         </Border>
        </Grid>
       </Grid>
      </Border>
     </Border>
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="LayoutCellButton" TargetType="Button" BasedOn="{StaticResource HomeButton}">
  <Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
  <Setter Property="CornerRadius" Value="8"/>
 </Style>
 <Style x:Key="OrderTileButton" TargetType="Button" BasedOn="{StaticResource UtilityButton}">
  <Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="12"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
 </Style>
 <!-- Same card dimensions/material as SharingSelectionCheckBox; selection is
      confined to the order badge instead of filling the entire card. -->
 <Style x:Key="OrderCardButton" TargetType="Button" BasedOn="{StaticResource UtilityButton}">
  <Setter Property="CornerRadius" Value="20"/><Setter Property="BorderThickness" Value="3"/>
  <Setter Property="Padding" Value="14,10"/><Setter Property="MinHeight" Value="64"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style x:Key="UtilityMultilineTextBox" TargetType="TextBox" BasedOn="{StaticResource UtilityTextBox}">
    <Setter Property="local:InteractionFocus.Enabled" Value="True" />
  <Setter Property="Height" Value="Auto"/>
  <Setter Property="Padding" Value="14,12"/>
  <Setter Property="VerticalContentAlignment" Value="Top"/>
  <Setter Property="HorizontalAlignment" Value="Stretch"/>
  <Setter Property="VerticalAlignment" Value="Stretch"/>
  <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
 </Style>

 <!-- Audio rule picker: bounded virtualized lists, existing card/check and scrollbar surfaces. -->
 <Style x:Key="AudioRulePickerList" TargetType="ListView">
  <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="2,2,8,4"/>
  <Setter Property="UseSystemFocusVisuals" Value="False"/>
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled"/>
  <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  <Setter Property="ScrollViewer.VerticalScrollMode" Value="Enabled"/>
  <Setter Property="ScrollViewer.IsVerticalScrollChainingEnabled" Value="False"/>
  <Setter Property="ItemContainerTransitions"><Setter.Value><TransitionCollection/></Setter.Value></Setter>
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListView">
   <Border Background="{TemplateBinding Background}">
    <ScrollViewer x:Name="ScrollViewer" Style="{StaticResource HomeScrollViewer}" TabNavigation="Local"
     HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollMode="Enabled"
     VerticalScrollBarVisibility="Auto" IsVerticalScrollChainingEnabled="False" IsVerticalRailEnabled="True"
     BringIntoViewOnFocusChange="True" ZoomMode="Disabled" AutomationProperties.AccessibilityView="Raw">
     <ItemsPresenter Padding="{TemplateBinding Padding}"/>
    </ScrollViewer>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AudioRulePickerCategoryItem" TargetType="ListViewItem" BasedOn="{StaticResource LibraryQueueItem}">
  <Setter Property="Margin" Value="0,4"/><Setter Property="CornerRadius" Value="14"/>
  <Setter Property="BorderBrush" Value="{StaticResource HomeFrameEdgeHoverBrush}"/>
  <Setter Property="Background" Value="{StaticResource HomeWellBrush}"/>
 </Style>
 <Style x:Key="AudioRulePickerParameterItem" TargetType="ListViewItem">
  <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="IsTabStop" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
   <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="AudioRulePickerGroupTemplate">
  <StackPanel Padding="14,12" Spacing="4" AutomationProperties.Name="{Binding AccessibleName}">
   <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" FontSize="15" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Description}" FontFamily="{StaticResource BodyFont}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
  </StackPanel>
 </DataTemplate>
 <DataTemplate x:Key="AudioRulePickerParameterTemplate">
  <Grid>
   <CheckBox Style="{StaticResource SharingSelectionCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
    IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding AccessibleName}">
    <StackPanel Spacing="4" Margin="0,0,58,0">
     <TextBlock Text="{Binding Name}" Foreground="{StaticResource HomeControlText}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" FontSize="15" TextWrapping="Wrap"/>
    </StackPanel>
   </CheckBox>
   <Border Visibility="{Binding AddedVisibility}" Background="{StaticResource HomeControlRecess}" BorderBrush="{StaticResource HomeFrameEdgeHoverBrush}" BorderThickness="1"
    CornerRadius="9" Padding="7,4" Margin="0,0,46,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
    <TextBlock Text="{local:UiString Source='已添加'}" Foreground="{StaticResource HomeControlText}" FontFamily="{StaticResource BodyFont}" FontSize="12"/>
   </Border>
  </Grid>
 </DataTemplate>
</ResourceDictionary>
