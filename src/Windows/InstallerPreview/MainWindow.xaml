<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ZZZwallpaper.InstallerPreview.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ZZZwallpaper 安装" Icon="Assets/App.ico" Width="1080" Height="600" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" FontFamily="{StaticResource BodyFont}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource HomeControlText}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
  <Viewbox Stretch="Uniform">
    <Grid x:Name="PreviewRoot" Width="1080" Height="600">
      <Border CornerRadius="22" Background="#070707" BorderBrush="#3B3B3B" BorderThickness="1,1,1,3">
        <Grid x:Name="MainContent">
          <Grid.Clip><RectangleGeometry Rect="0,0,1078,596" RadiusX="21" RadiusY="21" /></Grid.Clip>
          <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" CornerRadius="23,23,0,0" BorderBrush="#303030" BorderThickness="0,0,0,2" MouseLeftButtonDown="HeaderMouseDown">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#1C1C1C" />
                <GradientStop Color="#0C0C0C" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="26,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="48" />
              </Grid.ColumnDefinitions>
              <Image Source="Assets/wordmark.png" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
              <Button Grid.Column="2" Style="{StaticResource ShellCaptionButton}" Margin="0,0,7,0" Click="MinimizeClick" AutomationProperties.Name="最小化">
                <Grid Width="24" Height="24">
                  <Path Data="M5,11 L19,11 L19,13 L5,13 Z" Stretch="None" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
              </Button>
              <Button Grid.Column="3" Style="{StaticResource ShellCaptionButton}" Click="CloseClick" AutomationProperties.Name="关闭安装向导">
                <Grid Width="24" Height="24">
                  <Path Data="M6,4 L12,10 L18,4 L20,6 L14,12 L20,18 L18,20 L12,14 L6,20 L4,18 L10,12 L4,6 Z" Stretch="None" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
              </Button>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="355" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#242424" BorderThickness="0,0,1,0" ClipToBounds="True">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                  <GradientStop Color="#222222" />
                  <GradientStop Color="#111111" Offset="0.55" />
                  <GradientStop Color="#171717" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Image Source="Assets/Brand-A.png" Opacity="0.06" Stretch="UniformToFill" IsHitTestVisible="False" />
                <Canvas IsHitTestVisible="False" Opacity="0.12">
                  <Path Data="M 0,80 L 355,0 M 0,180 L 355,100 M 0,280 L 355,200 M 0,380 L 355,300 M 0,480 L 355,400" Stroke="#444444" StrokeThickness="42" />
                </Canvas>
                <Grid Margin="32,34,26,28">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Viewbox Grid.Row="3" Width="246" Height="185" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,5" IsHitTestVisible="False">
                    <Canvas Width="246" Height="185">
                      <Canvas.RenderTransform>
                        <RotateTransform Angle="-6" CenterX="123" CenterY="92" />
                      </Canvas.RenderTransform>
                      <Rectangle Canvas.Left="112" Canvas.Top="139" Width="27" Height="26" Fill="#333333" Stroke="#080808" StrokeThickness="4" />
                      <Rectangle Canvas.Left="78" Canvas.Top="163" Width="96" Height="10" RadiusX="5" RadiusY="5" Fill="#3A3A3A" Stroke="#090909" StrokeThickness="3" />
                      <Rectangle Canvas.Left="7" Canvas.Top="8" Width="230" Height="143" RadiusX="20" RadiusY="20" Fill="#080808" />
                      <Rectangle Canvas.Left="0" Canvas.Top="0" Width="230" Height="143" RadiusX="20" RadiusY="20" Fill="#171717" Stroke="#525252" StrokeThickness="3" />
                      <Rectangle Canvas.Left="6" Canvas.Top="6" Width="218" Height="131" RadiusX="14" RadiusY="14" Fill="#080808" Stroke="#333333" StrokeThickness="2" />
                      <Border Canvas.Left="13" Canvas.Top="13" Width="204" Height="117" CornerRadius="7" Background="#171A14" ClipToBounds="True">
                        <Grid>
                          <Path Data="M -30,110 L 70,0 M 0,120 L 100,0 M 30,120 L 130,0 M 60,120 L 160,0 M 90,120 L 190,0 M 120,120 L 220,0" Stroke="#252923" StrokeThickness="8" />
                          <TextBlock Text="Z" FontFamily="Arial" FontSize="132" FontWeight="Black" FontStyle="Italic" Foreground="#555E2F" HorizontalAlignment="Right" Margin="0,-21,9,0" />
                          <Path Data="M 0,0 L 0,38 L 32,19 Z" Fill="{DynamicResource HomeSelectionBrush}" Width="32" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                      <Path Data="M 235,10 L 244,4 M 238,26 L 246,27" Stroke="#798333" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                  </Viewbox>
                </Grid>
                <TextBlock x:Name="ProductVersion" FontSize="12" Foreground="#999999" Margin="28,0,0,24" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
              </Grid>
            </Border>
            <ContentControl Grid.Column="1" Style="{StaticResource HomeFrame}" Margin="16,12,16,12" Padding="18,16">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="43" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="0,0,0,16">
                  <StackPanel Orientation="Horizontal">
                    <Border x:Name="Step1Badge" Width="23" Height="23" CornerRadius="12" Background="{DynamicResource HomeSelectionBrush}">
                      <TextBlock x:Name="Step1Number" Text="01" Foreground="#111600" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step1Text" Text="安装设置" FontSize="12" VerticalAlignment="Center" Margin="7,0,20,0" />
                    <Border x:Name="Step2Badge" Width="23" Height="23" CornerRadius="12" BorderThickness="1" BorderBrush="#383838">
                      <TextBlock x:Name="Step2Number" Text="02" Foreground="#777777" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step2Text" Text="安装进度" FontSize="12" Foreground="#777777" VerticalAlignment="Center" Margin="7,0,20,0" />
                    <Border x:Name="Step3Badge" Width="23" Height="23" CornerRadius="12" BorderThickness="1" BorderBrush="#383838">
                      <TextBlock x:Name="Step3Number" Text="03" Foreground="#777777" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Step3Text" Text="完成" FontSize="12" Foreground="#777777" VerticalAlignment="Center" Margin="7,0,0,0" />
                  </StackPanel>
                </Border>
                <Grid Grid.Row="1" Margin="0,22,0,0">
                  <Grid x:Name="SettingsPage">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Style="{StaticResource HomeScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                      <StackPanel>
                        <TextBlock x:Name="SettingsTitle" Text="准备安装" Style="{StaticResource Heading}" Margin="0,0,0,20" />
                        <TextBlock Text="安装位置" FontWeight="Black" Margin="0,0,0,8" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                          </Grid.ColumnDefinitions>
                          <TextBox x:Name="InstallPath" AutomationProperties.Name="安装位置" />
                          <Button Grid.Column="1" Content="更改" Margin="10,0,0,0" Click="ChangePathClick" />
                        </Grid>
                        <TextBlock x:Name="PathError" Foreground="#F0AA8E" FontSize="12" Visibility="Collapsed" Margin="0,8,0,0" />
                        <CheckBox x:Name="DesktopShortcut" IsChecked="True" AutomationProperties.Name="创建桌面快捷方式" Margin="0,16,0,0">
                          <StackPanel>
                            <TextBlock Text="创建桌面快捷方式" FontWeight="Black" />
                          </StackPanel>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                          <Button x:Name="AgreementLink" Content="用户协议" Tag="agreement" Click="LegalClick" Margin="0,0,8,0" />
                          <Button Content="隐私说明" Tag="privacy" Click="LegalClick" Margin="0,0,8,0" />
                          <Button Content="第三方许可" Tag="third-party" Click="LegalClick" />
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1">
                      <CheckBox x:Name="AcceptAgreement" Content="我同意《用户协议》中的微软组件条款，并已阅读《隐私说明》" IsChecked="False" Margin="0,0,0,12" />
                      <Button x:Name="StartButton" Style="{StaticResource Primary}" IsEnabled="False" Click="StartClick">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="StartLabel" Text="开始安装" FontSize="14" FontWeight="Black" />
                          <Path Data="{StaticResource HomeIconChevronRight}" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" Margin="10,0,0,0" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <Grid x:Name="ProgressPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                      <TextBlock Text="正在安装" Style="{StaticResource Heading}" />
                      <Grid Margin="0,12,0,8">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="ProgressNumber" Text="0" FontSize="50" FontWeight="Black" Foreground="{DynamicResource HomeSelectionBrush}" />
                          <TextBlock Text="%" FontSize="18" Foreground="#999999" VerticalAlignment="Bottom" Margin="7,0,0,9" />
                        </StackPanel>
                      </Grid>
                      <Grid x:Name="ProgressTrack" Height="8">
                        <Border Background="{DynamicResource HomeControlEdge}" CornerRadius="4" />
                        <Border x:Name="ProgressFill" Background="{DynamicResource HomeSelectionBrush}" CornerRadius="4" HorizontalAlignment="Left" Width="0" />
                      </Grid>
                      <Grid Margin="0,12,0,8">
                        <TextBlock x:Name="ProgressStatus" Text="正在准备安装文件" FontSize="14" FontWeight="Bold" />
                        <TextBlock x:Name="ProgressFiles" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                      </Grid>
                      <TextBlock x:Name="ProgressFile" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Height="20" />
                      <Border BorderBrush="#292929" BorderThickness="0,1,0,0" Margin="0,11,0,0" Padding="0,11,0,0">
                        <StackPanel>
                          <TextBlock Text="目标位置" Style="{StaticResource Muted}" FontSize="12" />
                          <TextBlock x:Name="ProgressDestination" FontSize="14" Foreground="#BBBBBB" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,0" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <Grid Grid.Row="1">
                      <Button x:Name="CancelInstallButton" Content="取消安装" HorizontalAlignment="Right" Click="CancelClick" />
                    </Grid>
                  </Grid>
                  <Grid x:Name="CompletePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                      <ContentControl Style="{StaticResource HomeFrame}" Width="48" Height="48" HorizontalAlignment="Left" Padding="5" Margin="0,0,0,14">
                        <Path Data="{StaticResource HomeIconCheck}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource HomeSelectionBrush}" />
                      </ContentControl>
                      <TextBlock Text="安装完成" Style="{StaticResource Heading}" />
                      <Border Background="#090909" BorderBrush="#2D2D2D" BorderThickness="2" CornerRadius="14" Padding="17" Margin="0,17,0,19">
                        <StackPanel>
                          <TextBlock Text="安装位置" Style="{StaticResource Muted}" FontSize="12" />
                          <TextBlock x:Name="CompleteDestination" FontSize="14" Foreground="#C0C0C0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,6,0,0" />
                        </StackPanel>
                      </Border>
                      <CheckBox x:Name="LaunchAfter" AutomationProperties.Name="启动 ZZZwallpaper">
                        <StackPanel>
                          <TextBlock Text="启动 ZZZwallpaper" FontWeight="Black" />
                        </StackPanel>
                      </CheckBox>
                    </StackPanel>
                    <Button Grid.Row="1" Style="{StaticResource Primary}" Click="FinishClick">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="完成" FontSize="14" FontWeight="Black" />
                        <Path Data="{StaticResource HomeIconCheck}" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" Margin="10,0,0,0" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Grid x:Name="ErrorPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                      <Border Width="48" Height="48" HorizontalAlignment="Left" CornerRadius="15" Background="#302017" BorderBrush="#75533C" BorderThickness="2" Margin="0,5,0,22">
                        <TextBlock Text="!" FontSize="28" FontWeight="Black" Foreground="#E7AE80" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock x:Name="ErrorHeading" Text="安装未完成" Style="{StaticResource Heading}" />
                      <Border Background="#090909" BorderBrush="#2D2D2D" BorderThickness="2" CornerRadius="14" Padding="18" Margin="0,25,0,0">
                        <StackPanel>
                          <TextBlock x:Name="ErrorTitle" Foreground="#DFBFA3" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                      <Button x:Name="ExitAndInstallButton" Content="退出程序并安装" Style="{StaticResource Primary}" Click="ExitAndInstallClick" Visibility="Collapsed" Margin="0,0,0,12" />
                      <Button x:Name="ErrorBackButton" Content="返回设置" Style="{StaticResource Primary}" Click="BackClick" />
                    </StackPanel>
                  </Grid>
                  <Grid x:Name="CancelledPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                      <ContentControl Style="{StaticResource HomeFrame}" Width="48" Height="48" HorizontalAlignment="Left" Padding="5" Margin="0,5,0,22">
                        <Path Data="{StaticResource HomeIconPause}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource HomeControlText}" />
                      </ContentControl>
                      <TextBlock Text="安装已取消" Style="{StaticResource Heading}" />
                    </StackPanel>
                    <Button Grid.Row="1" Content="返回设置" Style="{StaticResource Primary}" Click="BackClick" />
                  </Grid>
                </Grid>
              </Grid>
            </ContentControl>
          </Grid>
        </Grid>
      </Border>
      <Border x:Name="ModalOverlay" Visibility="Collapsed" Background="#C7000000" CornerRadius="25" KeyboardNavigation.TabNavigation="Cycle">
        <ContentControl x:Name="ModalFrame" Style="{StaticResource HomeFrame}" Padding="24" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid>
            <StackPanel x:Name="CancelDialog" Visibility="Collapsed">
              <TextBlock Text="取消安装？" FontSize="24" FontWeight="Black" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="ConfirmCancelButton" Content="取消安装" Click="ConfirmCancelClick" Margin="0,0,12,0" />
                <Button x:Name="KeepInstallingButton" Content="继续安装" Style="{StaticResource Primary}" FontSize="14" MinHeight="48" Padding="18,0" Click="DismissModalClick" />
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="PathDialog" Visibility="Collapsed">
              <TextBlock Text="安装位置" FontSize="24" FontWeight="Black" Margin="0,0,0,24" />
              <TextBox x:Name="DialogPath" AutomationProperties.Name="安装文件夹" KeyDown="DialogPathKeyDown" />
              <TextBlock x:Name="DialogPathError" Foreground="#ECAF95" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="取消" Click="DismissModalClick" Margin="0,0,12,0" />
                <Button Content="确定" Style="{StaticResource Primary}" FontSize="14" MinHeight="48" Padding="18,0" Click="SavePathClick" />
              </StackPanel>
            </StackPanel>
            <Grid x:Name="LegalDialog" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="AgreementTab" Content="用户协议" Tag="agreement" Click="LegalTabClick" Margin="0,0,8,0" />
                  <Button x:Name="PrivacyTab" Content="隐私说明" Tag="privacy" Click="LegalTabClick" Margin="0,0,8,0" />
                  <Button x:Name="ThirdPartyTab" Content="第三方许可" Tag="third-party" Click="LegalTabClick" />
                </StackPanel>
                <Button x:Name="CloseLegalButton" Style="{StaticResource ShellCaptionButton}" HorizontalAlignment="Right" Click="DismissModalClick" AutomationProperties.Name="关闭文档">
                  <Path Data="M6,4 L12,10 L18,4 L20,6 L14,12 L20,18 L18,20 L12,14 L6,20 L4,18 L10,12 L4,6 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" />
                </Button>
              </Grid>
              <ComboBox x:Name="LicenseSelector" Grid.Row="1" DisplayMemberPath="Title" Visibility="Collapsed" Margin="0,0,0,12" MaxDropDownHeight="280" SelectionChanged="LicenseSelectionChanged" AutomationProperties.Name="第三方许可文件" />
              <TextBox x:Name="LegalText" Grid.Row="2" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="Wrap" Height="Auto" MinHeight="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Padding="14" FontSize="14" TextBlock.LineHeight="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBox.Template>
                  <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                      <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource HomeScrollViewer}" Focusable="False" />
                    </Border>
                  </ControlTemplate>
                </TextBox.Template>
              </TextBox>
            </Grid>
          </Grid>
        </ContentControl>
      </Border>
    </Grid>
  </Viewbox>
</Window>
