<Window x:Class="ZZZwallpaper.InstallerPreview.UninstallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ZZZwallpaper 卸载" Icon="Assets/App.ico" Width="880" Height="500" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" FontFamily="{StaticResource BodyFont}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource HomeControlText}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
  <Viewbox Stretch="Uniform">
    <Grid x:Name="PreviewRoot" Width="880" Height="500">
      <Border CornerRadius="22" Background="#101010" BorderBrush="#3B3B3B" BorderThickness="1,1,1,3">
        <Grid>
          <Grid.Clip><RectangleGeometry Rect="0,0,878,496" RadiusX="21" RadiusY="21" /></Grid.Clip>
          <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
          <Border BorderBrush="#303030" BorderThickness="0,0,0,2" MouseLeftButtonDown="HeaderMouseDown">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1C1C1C"/><GradientStop Color="#0C0C0C" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="26,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <Image Source="Assets/wordmark.png" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Button Grid.Column="2" Style="{StaticResource ShellCaptionButton}" Margin="0,0,7,0" Click="MinimizeClick" AutomationProperties.Name="最小化">
                <Path Data="M5,11 L19,11 L19,13 L5,13 Z" Width="24" Height="24" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Button>
              <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource ShellCaptionButton}" Click="CloseClick" AutomationProperties.Name="关闭卸载向导">
                <Path Data="M6,4 L12,10 L18,4 L20,6 L14,12 L20,18 L18,20 L12,14 L6,20 L4,18 L10,12 L4,6 Z" Width="24" Height="24" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Button>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <Image Source="Assets/Brand-A.png" Opacity="0.035" Stretch="UniformToFill" IsHitTestVisible="False"/>
            <ContentControl Style="{StaticResource HomeFrame}" Margin="22,18,22,0" Padding="26,22">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="StageTitle" Text="卸载 ZZZwallpaper" Style="{StaticResource Heading}"/>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,18">
                  <StackPanel x:Name="LocationPanel">
                    <TextBlock Text="安装位置" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" Margin="0,0,0,8"/>
                    <TextBlock x:Name="InstallLocation" Foreground="#B8B8B8" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="KeepPersonalData" Content="保留个人配置和数据" IsChecked="True" Margin="0,18,0,0"/>
                  <TextBlock x:Name="StatusText" Foreground="#B8B8B8" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
                <Grid x:Name="BusyTrack" Grid.Row="2" Height="8" Visibility="Collapsed" ClipToBounds="True">
                  <Border Background="{DynamicResource HomeControlEdge}" CornerRadius="4"/>
                  <Border x:Name="BusyIndicator" Background="{DynamicResource HomeSelectionBrush}" CornerRadius="4" Width="220" HorizontalAlignment="Left">
                    <Border.RenderTransform><TranslateTransform x:Name="BusyPosition"/></Border.RenderTransform>
                  </Border>
                </Grid>
              </Grid>
            </ContentControl>
          </Grid>
          <Grid Grid.Row="2" Margin="28,10,24,12">
            <TextBlock x:Name="ProductVersion" FontSize="12" Foreground="#999999" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="CancelButton" Content="取消" MinWidth="96" Margin="0,0,12,0" Click="CloseClick"/>
              <Button x:Name="ActionButton" Content="卸载" Style="{StaticResource Primary}" MinWidth="176" Click="ActionClick"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Viewbox>
</Window>
