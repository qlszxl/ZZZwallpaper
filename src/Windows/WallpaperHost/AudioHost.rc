#include <windows.h>
#pragma code_page(65001)
101 ICON "src\\Windows\\ControlCenter\\Assets\\Branding\\App.ico"
#ifndef AUDIO_SPECTRUM_HOST
// Embed the exact manifest at resource compilation; this avoids a dependency
// on linker discovery of mt.exe in restricted build environments.
1 RT_MANIFEST "src\\Windows\\WallpaperHost\\WallpaperHost.manifest"
#endif
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "ZZZwallpaper\0"
   VALUE "FileVersion", "1.0.0.0\0"
   VALUE "CompanyName", "人鱼子十\0"
#ifdef AUDIO_SPECTRUM_HOST
   VALUE "InternalName", "AudioSpectrumHost\0"
   VALUE "OriginalFilename", "AudioSpectrumHost.exe\0"
#else
   VALUE "InternalName", "WallpaperHost\0"
   VALUE "OriginalFilename", "WallpaperHost.exe\0"
#endif
   VALUE "ProductName", "ZZZwallpaper\0"
   VALUE "ProductVersion", "1.0.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
